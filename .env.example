# Copy to .env and fill in. Never commit .env.

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/dp7
PORT=3000
NODE_ENV=development
APP_TZ=Asia/Kolkata

# Long random string (openssl rand -hex 32)
SESSION_SECRET=

# First super admin, used only when none exists yet
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_PASSWORD=

# Encrypts TeleCMI and WhatsApp secrets. 32+ characters. Treat as permanent:
# changing it makes every saved secret unreadable. Same value on both services.
CREDENTIALS_ENCRYPTION_KEY=

# Public address of the web app, used to build the TeleCMI webhook address
APP_PUBLIC_URL=

# WhatsApp: shared secret between the web app and the WhatsApp service (32+ chars)
WA_INTERNAL_TOKEN=
# Web app: where the WhatsApp service is
WA_SERVICE_URL=http://127.0.0.1:3100
# WhatsApp service: where it listens. On Railway use WA_BIND_HOST=::
WA_PORT=3100
WA_BIND_HOST=127.0.0.1

# Outgoing public IP(s) of the web app, shown on Settings -> Calling for
# TeleCMI IP whitelisting. Comma separated.
SERVER_PUBLIC_IP=
