<%- include('partials/head') %>

<div class="page-head">
  <div class="titles">
    <h1>Call Log</h1>
    <div class="sub">
      <% if (isAdmin) { %>Who called whom and when — TeleCMI or manual.<% } else { %>Your own call record.<% } %>
    </div>
  </div>
  <div class="chips">
    <a class="chip" href="/calling/due"><%- icon('alert', 13) %> Follow-ups Due</a>
    <% if (cfg.enabled) { %>
      <span class="chip on"><%- icon('check', 13) %> TeleCMI connected</span>
    <% } else { %>
      <span class="chip"><%- icon('alert', 13) %>TeleCMI not set up</span>
    <% } %>
  </div>
</div>

<% if (!cfg.enabled) { %>
  <div class="flash flash-info">
    <span>
      <strong>TeleCMI keys are not set.</strong> The Call button only logs the call and shows the number — to auto-dial, add<a href="/settings?tab=telecmi">Settings → TeleCMI</a>App ID, Secret and Agent number.</span>
  </div>
<% } %>

<div class="stat-grid">
  <div class="stat"><div class="label">Calls</div><div class="value"><%= rows.length %></div><div class="hint">in this range</div></div>
  <% byCaller.slice(0, 3).forEach(function (c) { %>
    <div class="stat">
      <div class="label"><%= c.caller_name || '—' %></div>
      <div class="value"><%= c.calls %></div>
      <div class="hint"><%= c.customers %> customers · <%= Math.round(c.seconds / 60) %> min</div>
    </div>
  <% }); %>
</div>

<div class="card">
  <form method="get" action="/calls" class="filter-bar">
    <div><label>From</label><input type="date" name="from" value="<%= filters.from %>"></div>
    <div><label>To</label><input type="date" name="to" value="<%= filters.to %>"></div>
    <% if (isAdmin) { %>
    <div>
      <label>Caller</label>
      <select name="caller" data-autosubmit>
        <option value="">All callers</option>
        <% callers.forEach(function (c) { %>
          <option value="<%= c.id %>" <%= filters.caller === String(c.id) ? 'selected' : '' %>><%= c.name %></option>
        <% }); %>
      </select>
    </div>
    <% } %>
    <div><button class="btn btn-primary" type="submit"><%- icon('search', 15) %>View</button></div>
  </form>

  <div class="table-wrapper">
    <table>
      <thead><tr><th>Kab</th><th>Customer</th><th>Caller</th><th>Provider</th><th>Status</th><th class="right">Duration</th><th>Note</th></tr></thead>
      <tbody>
        <% if (!rows.length) { %>
          <tr><td colspan="7"><div class="empty"><span class="big">—</span>No calls in this range.</div></td></tr>
        <% } %>
        <% rows.forEach(function (k) { %>
          <tr>
            <td class="nowrap muted tiny"><%= helpers.prettyDateTime(k.called_at) %></td>
            <td><a href="/customers/<%= encodeURIComponent(k.username) %>"><strong><%= k.username %></strong></a></td>
            <td class="tiny"><%= k.caller_name || '—' %></td>
            <td><span class="badge badge-neutral"><%= k.provider %></span></td>
            <td class="tiny"><%= k.status %></td>
            <td class="right num"><%= k.duration_sec || 0 %>s</td>
            <td class="muted tiny"><%= k.note || '—' %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/foot') %>

