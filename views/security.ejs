<%- include('partials/head') %>

<div class="page-head">
  <div class="titles">
    <h1>Security</h1>
    <div class="sub">Your password, two-factor and login history.</div>
  </div>
</div>

<div class="grid-2">
  <div class="card">
    <div class="card-header"><h3><%- icon('shield', 15) %> Change password</h3></div>
    <form method="post" action="/security/password">
      <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
      <div class="card-body">
        <div class="form-group">
          <label>Current password</label>
          <input type="password" name="current_password" required autocomplete="current-password">
        </div>
        <div class="form-group">
          <label>New password</label>
          <input type="password" name="new_password" required minlength="6" autocomplete="new-password">
        </div>
        <div class="form-group">
          <label>Confirm new password</label>
          <input type="password" name="confirm_password" required minlength="6" autocomplete="new-password">
        </div>
      </div>
      <div class="card-footer" style="text-align:right">
        <button type="submit" class="btn btn-primary"><%- icon('check', 15) %> Update password</button>
      </div>
    </form>
  </div>

  <div class="card">
    <div class="card-header">
      <h3><%- icon('shield', 15) %> Two-factor (2FA)</h3>
      <span class="badge <%= me.totp_enabled ? 'badge-success' : 'badge-neutral' %>" style="margin-left:auto">
        <%= me.totp_enabled ? 'On' : 'Off' %>
      </span>
    </div>
    <div class="card-body">
      <% if (me.totp_enabled) { %>
        <p class="soft">A 6-digit code from your authenticator app is required at login.</p>
        <form method="post" action="/security/2fa/disable">
          <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
          <div class="form-group">
            <label>Password (to confirm)</label>
            <input type="password" name="password" required autocomplete="current-password">
          </div>
          <button type="submit" class="btn btn-danger" data-confirm="Turn off 2FA?">Disable 2FA</button>
        </form>

      <% } else if (qr) { %>
        <p class="soft">Scan this QR in Google Authenticator or Authy, then enter the code to confirm.</p>
        <div style="text-align:center;margin:14px 0">
          <img src="<%= qr %>" alt="2FA QR" style="width:200px;height:200px;border-radius:12px;background:#fff;padding:8px">
          <div class="muted tiny" style="margin-top:8px">Manual entry: <code><%= secret %></code></div>
        </div>
        <form method="post" action="/security/2fa/confirm">
          <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
          <div class="form-group">
            <label>6-digit code</label>
            <input type="text" name="token" inputmode="numeric" maxlength="6" required
                   style="letter-spacing:6px;text-align:center;font-size:18px;font-weight:700" placeholder="000000">
          </div>
          <button type="submit" class="btn btn-primary">Confirm &amp; enable</button>
        </form>

      <% } else { %>
        <p class="soft">With 2FA on, your account stays safe even if the password is stolen.</p>
        <form method="post" action="/security/2fa/start">
          <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-primary"><%- icon('shield', 15) %> Enable 2FA</button>
        </form>
      <% } %>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header"><h3><%- icon('clock', 15) %> Recent activity</h3></div>
  <div class="table-wrapper">
    <table>
      <thead><tr><th>Action</th><th>Detail</th><th>IP</th><th class="right">When</th></tr></thead>
      <tbody>
        <% if (!log.length) { %>
          <tr><td colspan="4"><div class="empty">No activity recorded.</div></td></tr>
        <% } %>
        <% log.forEach(function (l) { %>
          <tr>
            <td><span class="badge badge-neutral"><%= l.action.replace(/_/g, ' ') %></span></td>
            <td class="muted tiny"><%= l.detail || '—' %></td>
            <td class="muted tiny nowrap"><%= l.ip || '—' %></td>
            <td class="right muted tiny nowrap"><%= helpers.prettyDateTime(l.created_at) %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/foot') %>

