<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>Two-factor · DP7</title>
  <link rel="stylesheet" href="/style.css?v=<%= appVersion %>">
</head>
<body>
<div class="auth-wrap">
  <div class="auth-card">
    <h1>Two-factor code</h1>
    <p class="sub">Authenticator app me dikh raha 6-digit code daaliye</p>

    <% if (error) { %>
      <div class="flash flash-error"><%- icon('alert', 15) %> <span><%= error %></span></div>
    <% } %>

    <form method="post" action="/login/2fa">
      <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
      <div class="form-group">
        <label>Code</label>
        <input type="text" name="token" inputmode="numeric" pattern="[0-9 ]{6,7}" maxlength="7" required autofocus
               style="letter-spacing:8px;text-align:center;font-size:20px;font-weight:700" placeholder="000000">
      </div>
      <button type="submit" class="btn btn-primary" style="margin-top:6px">Verify</button>
    </form>

    <div class="auth-foot"><a href="/login">← Back to sign in</a></div>
  </div>
</div>
</body>
</html>

