<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title><%= _t('Two-factor · DP7') %></title>
  <link rel="stylesheet" href="/style.css?v=<%= assetVersion %>">
</head>
<body <%- include('partials/ui_text') %>>
<div class="auth-wrap">
  <div class="auth-card">
    <h1><%= _t('Two-factor code') %></h1>
    <p class="sub"><%= _t('Enter the 6-digit code from your authenticator app') %></p>

    <% if (error) { %>
      <div data-toast class="flash flash-error"><%- icon('alert', 15) %> <span><%= _tm(error) %></span></div>
    <% } %>

    <form method="post" action="/login/2fa">
      <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
      <div class="form-group">
        <label><%= _t('Code') %></label>
        <input type="text" name="token" inputmode="numeric" pattern="[0-9 ]{6,7}" maxlength="7" required autofocus
               style="letter-spacing:8px;text-align:center;font-size:20px;font-weight:700" placeholder="000000">
      </div>
      <button type="submit" class="btn btn-primary" style="margin-top:6px"><%= _t('Verify') %></button>
    </form>

    <div class="auth-foot"><a href="/login"><%= _t('← Back to sign in') %></a></div>
  </div>
</div>
<div style="position:fixed;top:14px;right:14px"><%- include('partials/lang_switch') %></div>
<script src="/ui.js?v=<%= assetVersion %>"></script>
</body>
</html>

