<%- include('partials/head') %>

<div class="page-head">
  <div class="titles">
    <h1>Follow-ups Due</h1>
    <div class="sub">How much each caller has pending, and who has gone overdue — at a glance.</div>
  </div>
  <div class="chips">
    <a class="chip" href="/calls"><%- icon('clock', 13) %> Call Log</a>
    <a class="chip" href="/calling"><%- icon('list', 13) %> Calling List</a>
  </div>
</div>

<div class="stat-grid">
  <div class="stat <%= totals.overdue ? 'bad' : 'ok' %>">
    <div class="label">Overdue</div>
    <div class="value"><%= totals.overdue %></div>
    <div class="hint">date passed — most urgent</div>
  </div>
  <div class="stat"><div class="label">Due today</div><div class="value"><%= totals.due %></div><div class="hint">dated today</div></div>
  <div class="stat"><div class="label">Total pending</div><div class="value"><%= totals.pending %></div><div class="hint">overdue + today</div></div>
  <div class="stat ok">
    <div class="label">Today's work</div>
    <div class="value"><%= totals.done %> <span style="font-size:15px;color:var(--fg-muted)">/ <%= totals.target %></span></div>
    <div class="hint"><%= totals.done_nodep %> no-deposit + <%= totals.done_dep %> deposited</div>
  </div>
</div>

<div class="card">
  <div class="card-header"><h3><%- icon('users', 15) %> Caller-wise</h3></div>
  <div class="table-wrapper">
    <table>
      <thead>
        <tr><th>Caller</th><th>Target</th><th class="right">Overdue</th><th class="right">Due today</th><th class="right">Total pending</th><th class="right">Scheduled ahead</th><th class="right">Assigned</th></tr>
      </thead>
      <tbody>
        <% if (!perCaller.length) { %>
          <tr><td colspan="7"><div class="empty">No customers assigned to a caller yet.</div></td></tr>
        <% } %>
        <% perCaller.forEach(function (c) { %>
          <tr>
            <td><strong><%= c.caller_name %></strong></td>
            <td style="min-width:200px">
              <%# Do alag target — No deposit aur Deposited %>
              <% [['No deposit', c.done_nodep, c.nodep_target],
                  ['Deposited',  c.done_dep,   c.dep_target]].forEach(function (t) {
                   const label = t[0], done = Number(t[1] || 0), tgt2 = Number(t[2] || 0);
                   const p2 = tgt2 ? Math.min(100, Math.round((done / tgt2) * 100)) : 0;
                   const full = tgt2 > 0 && done >= tgt2; %>
                <div style="display:flex;align-items:center;gap:7px;margin:3px 0">
                  <span class="tiny muted" style="width:74px"><%= label %></span>
                  <span class="num" style="font-size:11.5px;min-width:40px"><strong><%= done %></strong><span class="muted">/<%= tgt2 %></span></span>
                  <div class="progress-track" style="flex:1;height:5px">
                    <div class="progress-fill <%= full ? 'done' : '' %>" style="width:<%= p2 %>%"></div>
                  </div>
                  <span class="tiny" style="min-width:34px;text-align:right">
                    <% if (full) { %><span class="badge badge-success" style="font-size:9px">done</span>
                    <% } else if (!tgt2) { %><span class="muted">—</span>
                    <% } else { %><span class="muted"><%= tgt2 - done %></span><% } %>
                  </span>
                </div>
              <% }); %>
            </td>
            <td class="right num">
              <% if (c.overdue) { %><span class="badge badge-danger"><%= c.overdue %></span><% } else { %><span class="muted">0</span><% } %>
            </td>
            <td class="right num"><%= c.due %></td>
            <td class="right num"><strong><%= c.pending %></strong></td>
            <td class="right num muted"><%= c.snoozed %></td>
            <td class="right num"><%= c.total %></td>
          </tr>
        <% }); %>
      </tbody>
      <tfoot>
        <tr style="background:rgba(245,197,66,0.05)">
          <td><strong>Total</strong></td>
          <td class="num">
            <div class="tiny"><strong><%= totals.done_nodep %></strong> / <%= totals.target_nodep %> <span class="muted">No deposit</span></div>
            <div class="tiny"><strong><%= totals.done_dep %></strong> / <%= totals.target_dep %> <span class="muted">Deposited</span></div>
          </td>
          <td class="right num"><strong><%= totals.overdue %></strong></td>
          <td class="right num"><strong><%= totals.due %></strong></td>
          <td class="right num"><strong><%= totals.pending %></strong></td>
          <td class="right num muted">—</td>
          <td class="right num">—</td>
        </tr>
      </tfoot>
    </table>
  </div>
</div>

<div class="card" style="<%= totals.overdue ? 'border-color:rgba(255,107,116,0.35)' : '' %>">
  <div class="card-header">
    <h3><%- icon('alert', 15) %> Overdue customers</h3>
    <span class="muted tiny" style="margin-left:auto">most overdue first</span>
  </div>
  <div class="table-wrapper">
    <table>
      <thead>
        <tr><th>Customer</th><th>Mobile</th><th>Caller</th><th>Priority</th><th>Last remark</th><th>Follow-up was</th><th class="right">Late</th><th class="right">Deposits</th></tr>
      </thead>
      <tbody>
        <% if (!overdueRows.length) { %>
          <tr><td colspan="8"><div class="empty">
            <span class="big"><%- icon('check', 26) %></span>
            No follow-up is overdue. Everything is on time. 🎉
          </div></td></tr>
        <% } %>
        <% overdueRows.forEach(function (r) { %>
          <tr>
            <td class="who"><a href="/customers/<%= encodeURIComponent(r.username) %>"><strong><%= r.username %></strong></a></td>
            <td class="num nowrap"><%= r.mobile %></td>
            <td class="tiny"><%= r.caller_name %></td>
            <td><span class="badge <%= r.priority === 'P1' ? 'badge-danger' : 'badge-neutral' %>"><%= r.priority %></span></td>
            <td class="muted tiny"><%= r.action_type %></td>
            <td class="nowrap muted tiny"><%= helpers.prettyDate(r.follow_up_on) %></td>
            <td class="right num"><span class="badge badge-danger"><%= r.days_late %>days</span></td>
            <td class="right num"><%= r.deposit_count %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <% if (overdueRows.length >= 100) { %>
    <div class="card-footer muted tiny">Showing the first 100 only.</div>
  <% } %>
</div>

<div class="card">
  <div class="card-header"><h3><%- icon('check', 15) %> Who worked today</h3></div>
  <div class="table-wrapper">
    <table>
      <thead><tr><th>Caller</th><th class="right">Remarks</th><th class="right">Customers</th></tr></thead>
      <tbody>
        <% doneToday.forEach(function (d) { %>
          <tr>
            <td><strong><%= d.caller_name %></strong></td>
            <td class="right num"><%= d.remarks %></td>
            <td class="right num"><%= d.customers %></td>
          </tr>
        <% }); %>
        <% if (!doneToday.length) { %><tr><td colspan="3"><div class="empty">No remark logged today.</div></td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/foot') %>

