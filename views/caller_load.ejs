<%- include('partials/head') %>

<div class="page-head">
  <div class="titles">
    <h1><%= _t('Caller Load') %></h1>
    <div class="sub"> <%- _th('How much work each caller holds — and from here you can <strong>split customers evenly</strong>. Every caller gets a share of each priority, so VIP customers never pile up with one caller.') %> </div>
  </div>
  <div class="chips">
    <a class="chip <%= team === '' ? 'on' : '' %>" href="/callers"><%= _t('All') %></a>
    <a class="chip <%= team === 'retention' ? 'on' : '' %>" href="/callers?team=retention"><%= _t('Retention') %></a>
    <a class="chip <%= team === 'acquisition' ? 'on' : '' %>" href="/callers?team=acquisition"><%= _t('Acquisition') %></a>
  </div>
</div>

<div class="stat-grid">
  <div class="stat">
    <div class="label"><%= _t('Assigned') %></div>
    <div class="value"><%= totals.assigned.toLocaleString('en-IN') %></div>
    <div class="hint"><%= _t('{callers} callers', { callers: (totals.callers) }) %></div>
  </div>
  <div class="stat <%= totals.overdue ? 'bad' : 'ok' %>">
    <div class="label"><%= _t('Overdue') %></div>
    <div class="value"><%= totals.overdue.toLocaleString('en-IN') %></div>
    <div class="hint"><%= _t('date has passed') %></div>
  </div>
  <div class="stat">
    <div class="label"><%= _t('Total pending') %></div>
    <div class="value"><%= totals.pending.toLocaleString('en-IN') %></div>
    <div class="hint"><%= _t('overdue + due today') %></div>
  </div>
  <div class="stat ok">
    <div class="label"><%= _t('Done today') %></div>
    <div class="value"><%= totals.done.toLocaleString('en-IN') %></div>
    <div class="hint"><%= _t('customers touched') %></div>
  </div>
  <div class="stat <%= unassigned.total ? 'warn' : 'ok' %>">
    <div class="label"><%= _t('Unassigned') %></div>
    <div class="value"><%= unassigned.total.toLocaleString('en-IN') %></div>
    <div class="hint">P1: <%= unassigned.p1 %> · P2: <%= unassigned.p2 %> · P3: <%= unassigned.p3 %></div>
  </div>
  <div class="stat <%= totals.empty ? 'warn' : 'ok' %>">
    <div class="label"><%= _t('Empty callers') %></div>
    <div class="value"><%= totals.empty %></div>
    <div class="hint"><%= _t('{over} callers overloaded', { over: (totals.over) }) %></div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <h3><%- icon('users', 15) %> <%= _t('Callers') %></h3>
    <span class="muted tiny" style="margin-left:auto"><%= _t('Load health = assigned ÷ (target × 4 days)') %></span>
  </div>
  <div class="table-wrapper">
    <table>
      <thead>
        <tr>
          <th><%= _t('Caller') %></th>
          <th><%= _t('Team') %></th>
          <th class="right"><%= _t('Target') %></th>
          <th><%= _t('Load') %></th>
          <th class="right">P1</th>
          <th class="right">P2</th>
          <th class="right"><%= _t('Pending') %></th>
          <th class="right"><%= _t('Overdue') %></th>
          <th class="right"><%= _t('Done today') %></th>
          <th><%= _t('Last login') %></th>
        </tr>
      </thead>
      <tbody>
        <% if (!rows.length) { %>
          <tr><td colspan="10"><div class="empty">
            <span class="big">—</span><%= _t('No caller accounts.') %><a href="/users"><%= _t('Users') %></a><%= _t('page to create one.') %></div></td></tr>
        <% } %>
        <% rows.forEach(function (c) {
             const healthLabel = {
               empty: 'empty', light: 'light', ok: 'healthy',
               heavy: 'heavy', over: 'overloaded'
             }[c.health];
             const healthClass = {
               empty: 'badge-neutral', light: 'badge-info', ok: 'badge-success',
               heavy: 'badge-warn', over: 'badge-danger'
             }[c.health]; %>
          <tr>
            <td class="who">
              <strong><%= c.name %></strong>
              <div class="muted tiny"><%= c.login_id %><%= c.totp_enabled ? ' · 2FA' : '' %></div>
            </td>
            <td>
              <form method="post" action="/callers/<%= c.id %>/team" style="margin:0">
                <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                <select name="team" onchange="this.form.submit()" style="font-size:11.5px;padding:3px 6px;min-height:26px">
                  <option value="retention" <%= c.team === 'retention' ? 'selected' : '' %>><%= _t('Retention') %></option>
                  <option value="acquisition" <%= c.team === 'acquisition' ? 'selected' : '' %>><%= _t('Acquisition') %></option>
                </select>
              </form>
            </td>
            <td class="right num"><%= c.daily_target %></td>
            <td style="min-width:170px">
              <div style="display:flex;align-items:center;gap:8px">
                <span class="num" style="font-size:12.5px;min-width:62px">
                  <strong><%= c.assigned.toLocaleString('en-IN') %></strong>
                  <span class="muted">/<%= c.capacity.toLocaleString('en-IN') %></span>
                </span>
                <div class="progress-track" style="flex:1;height:7px">
                  <div class="progress-fill <%= c.health === 'ok' ? 'done' : '' %>"
                       style="width:<%= Math.min(100, c.utilisation) %>%;
                              <%= c.health === 'over' || c.health === 'heavy' ? 'background:linear-gradient(90deg,#b23b48,#ff6b74)' : (c.health === 'light' ? 'background:linear-gradient(90deg,#2b6f8f,#7fc9d8)' : '') %>"></div>
                </div>
                <span class="badge <%= healthClass %>" style="font-size:10px"><%= _t(healthLabel) %></span>
              </div>
            </td>
            <td class="right num"><%= c.p1 %></td>
            <td class="right num muted"><%= c.p2 %></td>
            <td class="right num"><strong><%= c.pending %></strong></td>
            <td class="right num">
              <% if (c.overdue) { %><span class="badge badge-danger"><%= c.overdue %></span><% } else { %><span class="muted">0</span><% } %>
            </td>
            <td class="right num"><%= c.done_today %></td>
            <td class="muted tiny nowrap"><%= c.last_login_at ? helpers.prettyDateTime(c.last_login_at) : _t('never') %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<% if (preview) { %>
  <div class="card" id="preview" style="border-color:rgba(245,197,66,0.45)">
    <div class="card-header" style="background:rgba(245,197,66,0.06)">
      <h3><%- icon('alert', 15) %> <%= _t('Preview — nothing saved yet') %></h3>
      <span class="badge badge-warn" style="margin-left:auto"><%= _t('{total} customers', { total: (preview.total) }) %></span>
    </div>
    <div class="card-body">
      <p class="soft" style="margin-top:0">
        <%- _th('{n} {n2} · total available <strong>{available}</strong> · about <strong>{perCaller}</strong>', { n: (preview.scope === 'all' ? 'All customers (re-split)' : 'Unassigned'), n2: (preview.priority ? '· sirf ' + preview.priority : ''), available: (preview.available), perCaller: (preview.perCaller) }) %>
      </p>
      <div class="table-wrapper" style="border:1px solid var(--border);border-radius:10px">
        <table>
          <thead><tr><th style="width:34%"><%= _t('Caller') %></th><th class="right" style="width:22%"><%= _t('Will get') %></th><th class="right">P1</th><th class="right">P2</th><th class="right">P3</th><th class="right">P4</th></tr></thead>
          <tbody>
            <% preview.rows.forEach(function (r) { %>
              <tr>
                <td><strong><%= r.name %></strong></td>
                <td class="right num"><strong><%= r.count %></strong></td>
                <td class="right num"><%= r.P1 %></td>
                <td class="right num muted"><%= r.P2 %></td>
                <td class="right num muted"><%= r.P3 %></td>
                <td class="right num muted"><%= r.P4 %></td>
              </tr>
            <% }); %>
          </tbody>
          <tfoot>
            <tr style="background:rgba(245,197,66,0.05)">
              <td><strong><%= _t('Total') %></strong></td>
              <td class="right num"><strong><%= preview.total %></strong></td>
              <td colspan="4"></td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
    <div class="card-footer" style="display:flex;gap:9px;justify-content:flex-end">
      <form method="post" action="/callers/cancel" style="margin:0">
        <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
        <button class="btn btn-ghost" type="submit"><%= _t('Cancel') %></button>
      </form>
      <form method="post" action="/callers/apply" style="margin:0">
        <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
        <button class="btn btn-primary" type="submit"
                data-confirm="<%= _t('{total} customers will be assigned. Confirm?', { total: (preview.total) }) %>">
          <%- icon('check', 15) %> <%= _t('Assign') %> </button>
      </form>
    </div>
  </div>
<% } %>

<div class="card">
  <div class="card-header">
    <h3><%- icon('layers', 15) %> <%= _t('Even auto-split') %></h3>
  </div>
  <form method="post" action="/callers/preview">
    <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
    <div class="card-body">
      <p class="muted tiny" style="margin:0 0 14px"><%- _th('Split customers evenly in one click. A <strong>Preview</strong> is shown first — until you press Assign, nothing changes.') %> </p>

      <div class="form-row">
        <div class="form-group">
          <label><%= _t('Which customers') %></label>
          <select name="scope">
            <option value="unassigned"><%= _t('Unassigned ({total})', { total: (unassigned.total.toLocaleString('en-IN')) }) %></option>
            <option value="all"><%= _t('All customers (re-split)') %></option>
          </select>
        </div>
        <div class="form-group">
          <label><%= _t('Priority') %> <span class="muted tiny"><%= _t('(optional)') %></span></label>
          <select name="priority">
            <option value=""><%= _t('All priorities') %></option>
            <option value="P1"><%= _t('P1 only — inactive VIP') %></option>
            <option value="P2"><%= _t('P2 only') %></option>
            <option value="P3"><%= _t('P3 only') %></option>
          </select>
        </div>
        <div class="form-group">
          <label><%= _t('How many per caller') %><span class="muted tiny"><%= _t('(blank = even)') %></span></label>
          <input type="number" name="per_caller" min="0" step="1" placeholder="<%= _t('auto') %>">
        </div>
        <div class="form-group">
          <label><%= _t('How many to distribute in total') %> <span class="muted tiny"><%= _t('(blank = all)') %></span></label>
          <input type="number" name="take" min="0" step="1" placeholder="<%= _t('all') %>">
        </div>
      </div>

      <div class="form-group" style="margin-top:6px">
        <label><%= _t('Which callers to distribute to') %></label>
        <div class="check-row" data-check-scope>
          <label class="check-pill"><input type="checkbox" data-check-all> <span><%= _t('Select all') %></span></label>
          <% const previewIds = preview ? preview.rows.map(function (r) { return r.id; }) : []; %>
          <% callers.forEach(function (c) {
               const ticked = preview
                 ? previewIds.indexOf(c.id) !== -1
                 : (c.assigned === 0 && c.team === 'retention'); %>
            <label class="check-pill">
              <input type="checkbox" name="caller_id" value="<%= c.id %>" data-checkable <%= ticked ? 'checked' : '' %>>
              <span><%= c.name %> <span class="muted tiny">(<%= c.assigned %> · <%= c.team === 'acquisition' ? _t('acq') : _t('ret') %>)</span></span>
            </label>
          <% }); %>
        </div>
        <span class="muted tiny"><%= _t('Empty callers are pre-selected.') %></span>
      </div>
    </div>
    <div class="card-footer" style="text-align:right">
      <button class="btn btn-primary" type="submit"><%- icon('search', 15) %> <%= _t('Build preview') %></button>
    </div>
  </form>
</div>

<% if (lastRuns.length) { %>
  <div class="card">
    <div class="card-header"><h3><%- icon('clock', 15) %> <%= _t('Past splits') %></h3></div>
    <div class="table-wrapper">
      <table>
        <thead><tr><th><%= _t('When') %></th><th><%= _t('By') %></th><th><%= _t('Scope') %></th><th class="right"><%= _t('Total') %></th><th class="right"><%= _t('Callers') %></th><th class="right"><%= _t('Per caller') %></th></tr></thead>
        <tbody>
          <% lastRuns.forEach(function (r) { %>
            <tr>
              <td class="nowrap muted tiny"><%= helpers.prettyDateTime(r.run_at) %></td>
              <td class="tiny"><%= r.by_name || '—' %></td>
              <td class="tiny"><%= r.scope === 'all' ? 'Sab customers' : 'Unassigned' %></td>
              <td class="right num"><strong><%= r.total %></strong></td>
              <td class="right num"><%= r.callers %></td>
              <td class="right num">~<%= r.per_caller %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>

<div class="card">
  <div class="card-header"><h3><%- icon('alert', 15) %> <%= _t('How auto-split works') %></h3></div>
  <div class="card-body">
    <dl class="kv">
      <dt><%= _t('Even') %></dt>
      <dd><%= _t('Every caller gets roughly the same count — 2,786 across 8 callers is 348 each') %></dd>
      <dt><%= _t('Priority mix') %></dt>
      <dd><%- _th('Each priority (P1, P2, P3, P4) is shared out <strong>separately</strong> in turn — so VIP customers do not all land on one caller; each gets an equal share') %></dd>
      <dt><%= _t('P0 skip') %></dt>
      <dd><%= _t('"Do Not Contact" customers are never assigned') %></dd>
      <dt><%= _t('Load health') %></dt>
      <dd><%= _t('assigned ÷ (target × 4 days) — around 100% is healthy, above 130% is heavy') %></dd>
      <dt><%= _t('Team') %></dt>
      <dd><%- _th('<strong>Retention</strong> = follow-up on existing clients · <strong>Acquisition</strong>= bringing in new clients') %></dd>
    </dl>
  </div>
</div>

<%- include('partials/foot') %>

