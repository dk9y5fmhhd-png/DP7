    </div><!-- /.content -->
  </main>
</div><!-- /.app -->

<dialog id="followupDialog">
  <form method="post" action="/followups">
    <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
    <input type="hidden" name="username" id="fu_username">
    <div class="dialog-head">
      <h3><%- icon('phone', 15) %> <%= _t('Add Follow-up') %></h3>
      <button type="button" class="close-x" onclick="document.getElementById('followupDialog').close()">&times;</button>
    </div>
    <div class="dialog-body">
      <p class="muted tiny" style="margin:0 0 12px"><%= _t('Client:') %> <strong id="fu_who" style="color:var(--fg)"></strong></p>
      <div class="form-group">
        <label><%= _t('Action Type') %></label>
        <select name="action_type" id="fu_action" required>
          <option value=""><%= _t('Select action…') %></option>
          <% ACTION_TYPES.forEach(function (a) { %>
            <option value="<%= a %>"><%= _t(a) %></option>
          <% }); %>
        </select>
      </div>
      <div class="form-group">
        <label><%= _t('Date') %></label>
        <input type="date" name="action_date" value="<%= helpers.today() %>" required>
      </div>
      <div class="form-group">
        <label><%= _t('Response / Notes') %></label>
        <textarea name="response" rows="3" required placeholder="<%= _t('What was discussed…') %>" style="min-height:90px"></textarea>
      </div>
    </div>
    <div class="dialog-foot">
      <button type="button" class="btn btn-ghost" onclick="document.getElementById('followupDialog').close()"><%= _t('Cancel') %></button>
      <button type="submit" class="btn btn-primary"><%- icon('check', 15) %> <%= _t('Save follow-up') %></button>
    </div>
  </form>
</dialog>

<script src="/ui.js?v=<%= assetVersion %>"></script>
<script src="/app.js?v=<%= assetVersion %>"></script>
<% if (page === 'users') { %><script src="/users.js?v=<%= assetVersion %>"></script><% } %>
<script src="/wa.js?v=<%= assetVersion %>"></script>
<script src="/popups.js?v=<%= assetVersion %>"></script>
</body>
</html>

