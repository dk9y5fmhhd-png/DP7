<%- include('partials/head') %>

<div class="page-head">
  <div class="titles">
    <h1><%= _t('My Calls') %></h1>
    <div class="sub">
      <%- _th('{today} · only <strong>due today</strong> customers. Anything scheduled ahead returns on its own day.', { today: (helpers.prettyDateLong(today)) }) %> </div>
  </div>
  <div class="chips">
    <a class="chip <%= showAll ? '' : 'on' %>" href="/calling/my?tab=<%= tab %>"><%- icon('phone', 13) %> <%= _t('Due today') %></a>
    <a class="chip <%= showAll ? 'on' : '' %>" href="/calling/my?tab=<%= tab %>&all=1"><%- icon('list', 13) %> <%= _t('Full list') %></a>
    <% if (can('whatsapp')) { %><a class="chip <%= waWaiting ? 'on' : '' %>" href="/whatsapp"><span style="color:#25D366"><%- icon('whatsapp', 13) %></span> <%= _t('WhatsApp inbox') %><% if (waWaiting) { %> · <%= _t('{n} need a reply', { n: waWaiting }) %><% } %></a><% } %>
  </div>
</div>

<%# Do alag queue — naya ID aur deposit wala customer kabhi mila-jula na dikhe %>
<div class="tab-switch">
  <a class="tab-btn <%= tab === 'nodep' ? 'on' : '' %>" href="/calling/my?tab=nodep<%= showAll ? '&all=1' : '' %>">
    <span class="tab-name"><%= _t('No deposit') %></span>
    <span class="tab-meta">
      <%- _th('<strong>{done}</strong>/{target} today', { done: (doneFor.nodep), target: (targets.nodep) }) %> ·
      <%- _th('<strong>{nodep_due}</strong> due · {nodep} total', { nodep_due: (tabCounts.nodep_due), nodep: (tabCounts.nodep) }) %> </span>
    <span class="tab-note"><%= _t('ID created, first deposit pending') %></span>
  </a>
  <a class="tab-btn <%= tab === 'dep' ? 'on' : '' %>" href="/calling/my?tab=dep<%= showAll ? '&all=1' : '' %>">
    <span class="tab-name"><%= _t('Deposited') %></span>
    <span class="tab-meta">
      <%- _th('<strong>{done}</strong>/{target} today', { done: (doneFor.dep), target: (targets.dep) }) %> ·
      <%- _th('<strong>{dep_due}</strong> due · {dep} total', { dep_due: (tabCounts.dep_due), dep: (tabCounts.dep) }) %> </span>
    <span class="tab-note"><%= _t('Follow-up on existing customers') %></span>
  </a>
</div>

<div class="card" style="<%= target.complete ? 'border-color:rgba(70,211,154,0.45)' : '' %>">
  <div class="card-body">
    <div style="display:flex;align-items:flex-end;gap:14px;flex-wrap:wrap">
      <div style="flex:1 1 240px">
        <div class="label" style="font-size:11px;text-transform:uppercase;letter-spacing:0.08em;color:var(--fg-muted);font-weight:700">
          <%= _t('Today\'s target') %> — <%= tab === 'nodep' ? _t('No deposit') : _t('Deposited') %>
        </div>
        <div style="display:flex;align-items:baseline;gap:8px;margin-top:6px">
          <span style="font-size:34px;font-weight:800;letter-spacing:-0.02em;font-variant-numeric:tabular-nums;<%= target.complete ? 'color:var(--success)' : '' %>"><%= target.done %></span>
          <span style="font-size:18px;color:var(--fg-muted);font-weight:600">/ <%= target.target %></span>
          <% if (target.unlimited) { %>
            <span class="badge badge-neutral" style="margin-left:4px"><%= _t('no limit') %></span>
          <% } else if (target.complete) { %>
            <span class="badge badge-success" style="margin-left:4px"><%- icon('check', 12) %><%= _t('Target complete') %></span>
          <% } else { %>
            <span class="badge badge-neutral" style="margin-left:4px"><%= _t('{remaining} left', { remaining: (target.remaining) }) %></span>
          <% } %>
        </div>
      </div>
      <div style="flex:0 0 220px;text-align:right">
        <div class="muted tiny"><%= _t('Customers touched today') %></div>
        <div class="muted tiny"><%- _th('Due in queue:<strong>{queueCount}</strong>', { queueCount: (queueCount) }) %></div>
      </div>
    </div>

    <% if (!target.unlimited) { %>
    <div class="progress-track" style="margin-top:14px">
      <div class="progress-fill <%= target.complete ? 'done' : '' %>" style="width:<%= target.pct %>%"></div>
    </div>
    <div style="display:flex;justify-content:space-between;margin-top:6px" class="muted tiny">
      <span><%= _t('{pct}% complete', { pct: (target.pct) }) %></span>
      <span><%= target.complete ? _t('Well done — today\'s work is finished') : target.remaining + _t(' customers left') %></span>
    </div>
    <% } %>
  </div>
</div>

<div class="stat-grid">
  <div class="stat">
    <div class="label"><%= _t('Due today') %></div>
    <div class="value"><%= stats.due + stats.overdue %></div>
    <div class="hint"><%- _th('today + overdue · P1:<strong>{due_p1}</strong>', { due_p1: (stats.due_p1) }) %></div>
  </div>
  <div class="stat <%= stats.overdue ? 'bad' : 'ok' %>">
    <div class="label"><%= _t('Overdue') %></div>
    <div class="value"><%= stats.overdue %></div>
    <div class="hint"><%= stats.overdue ? _t('date passed — clear these first') : _t('nothing pending') %></div>
  </div>
  <div class="stat">
    <div class="label"><%= _t('Due today — tier') %></div>
    <div class="value" style="font-size:17px;letter-spacing:0">
      <span style="color:var(--accent-2)">N <%= stats.due_n %></span>
      <span class="muted" style="font-size:12px"> · </span>
      <span style="color:var(--success)">A <%= stats.due_a %></span>
      <span class="muted" style="font-size:12px"> · </span>
      B <%= stats.due_b %>
      <span class="muted" style="font-size:12px"> · </span>
      <span class="muted">C <%= stats.due_c %></span>
    </div>
    <div class="hint"><%= _t('VIP first, then normal, then dormant') %></div>
  </div>
  <div class="stat ok">
    <div class="label"><%= _t('Done today') %></div>
    <div class="value"><%= doneToday.remarks %></div>
    <div class="hint"><%= _t('{customers} customers', { customers: (doneToday.customers) }) %></div>
  </div>
  <div class="stat">
    <div class="label"><%= _t('Scheduled ahead') %></div>
    <div class="value"><%= stats.snoozed %></div>
    <div class="hint"><%= _t('they return on their scheduled day') %></div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <h3><%- icon('phone', 15) %> <%= tab === 'nodep' ? _t('No deposit — new IDs') : _t('Deposited customers') %> · <%= showAll ? _t('full list') : _t('today\'s list') %></h3>
    <span class="muted tiny" style="margin-left:auto">
      <% if (showAll || forceAll) { %>
        <%= _t('{n} customers · overdue → VIP → normal → dormant', { n: (rows.length) }) %><% } else { %>
        <%= _t('{n} shown (by today\'s target)', { n: (rows.length) }) %><% } %>
    </span>
  </div>

  <% if (!showAll && !forceAll && target.complete) { %>
    <div class="card-body" style="padding:26px 18px;text-align:center">
      <div style="font-size:30px;line-height:1">✅</div>
      <h3 style="margin:10px 0 6px"><%= _t('Today\'s target complete —{done} / {target}', { done: (target.done), target: (target.target) }) %></h3>
      <p class="muted" style="margin:0 0 14px"> <%= _t('You have finished today\'s work. If you still want to call ahead, open the full list below — but do take a break first.') %> </p>
      <a class="btn btn-primary" href="/calling/my?full=1"><%= _t('Show the full list anyway ({queueCount})', { queueCount: (queueCount) }) %></a>
    </div>
  <% } %>
  <div class="table-wrapper">
    <table>
      <thead>
        <tr>
          <th><%= _t('Customer') %></th>
          <th><%= _t('Mobile') %></th>
          <th>VIP</th>
          <th><%= _t('Tier') %></th>
          <th><%= _t('Cadence') %></th>
          <th class="right"><%= _t('Deposits') %></th>
          <th><%= _t('Last remark') %></th>
          <th class="right"><%= _t('Action') %></th>
        </tr>
      </thead>
      <tbody>
        <% if (!rows.length) { %>
          <tr><td colspan="8"><div class="empty">
            <span class="big"><%- icon('check', 26) %></span>
            <% if (showAll) { %>
              <%= tab === 'nodep' ? _t('No no-deposit customers right now.') : _t('No deposited customers assigned yet.') %>
            <% } else if (target.complete) { %> <%= _t('Target complete — open the full list above.') %> <% } else if (tab === 'nodep') { %> <%= _t('No new ID is due today. Well done! 🎉') %> <div class="muted tiny" style="margin-top:8px"><%= _t('New IDs appear here automatically once uploaded.') %></div>
            <% } else { %> <%= _t('No follow-up pending today. Well done! 🎉') %> <div class="muted tiny" style="margin-top:8px"><%= _t('Anything scheduled ahead returns here on its own day.') %></div>
            <% } %>
          </div></td></tr>
        <% } %>
        <% if (hiddenCount > 0) { %>
          <tr><td colspan="8" style="text-align:center;background:rgba(245,197,66,0.05)">
            <span class="muted tiny">
              <%- _th('<strong>{hiddenCount}</strong> more customers are due, but they fall outside today\'s target — they sit at the top of tomorrow\'s list.', { hiddenCount: (hiddenCount) }) %> </span>
          </td></tr>
        <% } %>
        <% rows.forEach(function (r) {
             const overdue = r.next_touch_on && r.days_late > 0; %>
          <tr style="<%= overdue ? 'background:rgba(255,107,116,0.06)' : '' %>">
            <td class="who">
              <a href="/customers/<%= encodeURIComponent(r.username) %>"><strong><%= r.username %></strong></a>
              <% if (r.status === 'no_deposit') { %><span class="badge badge-warn"><%= _t('ID created · no deposit') %></span><% } %>
              <% if (r.deposit_claimed_at) { %><span class="badge badge-success"><%= _t('marked Deposited') %></span><% } %>
              <% if (r.calls_today > 0) { %><span class="badge badge-info"><%= _t('{calls_today} call', { calls_today: (r.calls_today) }) %></span><% } %>
            </td>
            <td class="num nowrap"><%= r.mobile_shown %></td>
            <td>
              <% if (r.vip_category !== 'normal') { %>
                <span class="badge <%= r.vip_category === 'high_value_vip' ? 'badge-accent' : (r.vip_category === 'premium_vip' ? 'badge-warn' : 'badge-success') %>">
                  <%= _t(labels.VIP_LABEL[r.vip_category]) %>
                </span>
              <% } else { %><span class="muted">—</span><% } %>
            </td>
            <td>
              <span class="badge <%= r.cadence_tier === 'N' ? 'badge-warn' : (r.cadence_tier === 'A' ? 'badge-success' : (r.cadence_tier === 'C' ? 'badge-neutral' : 'badge-info')) %>"><%= r.cadence_tier || 'B' %></span>
            </td>
            <td class="nowrap">
              <% if (r.days_late > 0) { %>
                <span class="badge badge-danger"><%= _t('{days_late} days late', { days_late: (r.days_late) }) %></span>
                <div class="muted tiny"><%= helpers.prettyDate(r.next_touch_on) %></div>
              <% } else if (r.never_scheduled) { %>
                <span class="badge badge-warn"><%= _t('never scheduled') %></span>
              <% } else if (r.days_late < 0) { %>
                <span class="badge badge-neutral"><%= _t('{days_late} days later', { days_late: (-r.days_late) }) %></span>
                <div class="muted tiny"><%= helpers.prettyDate(r.next_touch_on) %></div>
              <% } else { %>
                <span class="badge badge-success"><%= _t('Today') %></span>
              <% } %>
              <% if (r.last_touched_at) { %>
                <div class="muted tiny"><%= _t('{days_since_touch} days since last touch', { days_since_touch: (r.days_since_touch) }) %></div>
              <% } %>
            </td>
            <td class="right num"><strong><%= r.deposit_count %></strong></td>
            <td class="muted tiny">
              <%= _t(r.last_remark || '—') %>
              <% if (r.last_outcome) { %><div class="muted tiny"><%= r.last_outcome %></div><% } %>
            </td>
            <td class="right nowrap">
              <form method="post" action="/calls/call" style="display:inline;margin:0">
                <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                <input type="hidden" name="username" value="<%= r.username %>">
                <button class="btn btn-sm btn-primary" type="submit" data-dial="<%= r.username %>" data-mobile="<%= r.mobile_shown %>"><%- icon('phone', 13) %> <%= _t('Call') %></button>
              </form>
              <% if (can('whatsapp')) { %><a class="btn btn-sm" href="/whatsapp/customer/<%= encodeURIComponent(r.username) %>" data-wa title="WhatsApp"><span style="color:#25D366"><%- icon('whatsapp', 13) %></span> WhatsApp</a><% } %>
              <button class="btn btn-sm" type="button"
                      data-username="<%= r.username %>"
                      data-remark="<%= r.last_remark || '' %>"
                      onclick="openRemark(this)"><%= _t('Remark') %></button>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<% if (upcoming.length) { %>
  <div class="card">
    <div class="card-header">
      <h3><%- icon('clock', 15) %> <%= _t('Upcoming follow-ups') %></h3>
      <span class="muted tiny" style="margin-left:auto"><%= _t('they move into today\'s list on their day') %></span>
    </div>
    <div class="table-wrapper">
      <table>
        <thead><tr><th><%= _t('Customer') %></th><th><%= _t('Next follow-up') %></th><th><%= _t('In how many days') %></th><th><%= _t('Last remark') %></th></tr></thead>
        <tbody>
          <% upcoming.forEach(function (u) { %>
            <tr>
              <td><a href="/customers/<%= encodeURIComponent(u.username) %>"><strong><%= u.username %></strong></a></td>
              <td class="nowrap"><strong><%= helpers.prettyDate(u.next_touch_on) %></strong></td>
              <td class="num"><%= _t('{in_days} days', { in_days: (u.in_days) }) %></td>
              <td class="muted tiny"><%= _t(u.last_remark || '—') %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>

<dialog id="remarkDialog">
  <form method="post" action="/calling/remark">
    <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
    <input type="hidden" name="username" id="rm_username">
    <div class="dialog-head">
      <h3><%- icon('phone', 15) %> <%= _t('Remark') %></h3>
      <button type="button" class="close-x" onclick="document.getElementById('remarkDialog').close()">&times;</button>
    </div>
    <div class="dialog-body">
      <p class="muted tiny" style="margin:0 0 12px"><%= _t('Customer:') %> <strong id="rm_who" style="color:var(--fg)"></strong></p>

      <div class="form-group">
        <label><%= _t('Remark') %></label>
        <select name="action_type" id="rm_action" required onchange="guessDate()">
          <option value=""><%= _t('— choose —') %></option>
          <% remarks.forEach(function (r) { %>
            <option value="<%= r.key %>" data-days="<%= r.days %>">
              <%= _t(r.key) %><%= r.days ? ' — ' + (r.days === 1 ? _t('tomorrow') : _t('{d} days', { d: r.days })) : (r.key === 'Deposited' ? ' — ' + _t('moves to Deposited') : (r.key === 'Fake' ? ' — ' + _t('delete') : '')) %>
            </option>
          <% }); %>
        </select>
        <span class="muted tiny" id="rm_hint"><%= _t('Picking a remark schedules the next follow-up automatically.') %></span>
      </div>

      <div class="form-group">
        <label><%= _t('Next follow-up') %> <span class="muted tiny"><%= _t('(change if needed)') %></span></label>
        <div class="chips" style="margin-bottom:8px">
          <% quickDates.forEach(function (q) { %>
            <button type="button" class="chip" onclick="setGap(<%= q.days %>, this)"><%= _t(q.label) %></button>
          <% }); %>
        </div>
        <input type="hidden" name="follow_gap" id="rm_gap">
        <input type="date" name="follow_up_on" id="rm_fu" min="<%= today %>">
      </div>

      <div class="form-group">
        <label><%= _t('Date (today)') %></label>
        <input type="date" name="action_date" value="<%= today %>" required>
      </div>
      <div class="form-group">
        <label><%= _t('Note') %></label>
        <textarea name="response" rows="3" style="min-height:76px" placeholder="<%= _t('e.g. will deposit ₹500 in 2 days') %>"></textarea>
      </div>
    </div>
    <div class="dialog-foot">
      <button type="button" class="btn btn-ghost" onclick="document.getElementById('remarkDialog').close()"><%= _t('Cancel') %></button>
      <button type="submit" class="btn btn-primary"><%- icon('check', 15) %> <%- _th('Save &amp; next') %></button>
    </div>
  </form>
</dialog>

<script>
  function openRemark(btn) {
    document.getElementById('rm_username').value = btn.dataset.username;
    document.getElementById('rm_who').textContent = btn.dataset.username;
    document.getElementById('rm_action').value = '';
    document.getElementById('rm_fu').value = '';
    document.getElementById('rm_gap').value = '';
    document.querySelectorAll('#remarkDialog .chip').forEach(function (c) { c.classList.remove('on'); });
    document.getElementById('rm_hint').textContent = <%- _js('Picking a remark schedules the next follow-up automatically.') %>;
    document.getElementById('remarkDialog').showModal();
  }

  function todayISO() { return '<%= today %>'; }

  function addDays(iso, n) {
    var d = new Date(iso + 'T00:00:00Z');
    d.setUTCDate(d.getUTCDate() + n);
    return d.toISOString().slice(0, 10);
  }

  function setDateIso(iso) {
    document.getElementById('rm_fu').value = iso;
  }

  function setGap(days, chip) {
    document.getElementById('rm_gap').value = days;
    setDateIso(addDays(todayISO(), Number(days)));
    document.querySelectorAll('#remarkDialog .chip').forEach(function (c) { c.classList.remove('on'); });
    if (chip) chip.classList.add('on');
  }

  function guessDate() {
    var sel = document.getElementById('rm_action');
    var opt = sel.options[sel.selectedIndex];
    var days = opt ? Number(opt.dataset.days) : NaN;
    var key = opt ? opt.value : '';
    document.getElementById('rm_gap').value = '';
    document.querySelectorAll('#remarkDialog .chip').forEach(function (c) { c.classList.remove('on'); });

    var hint = document.getElementById('rm_hint');

    if (key === 'Deposited') {
      setDateIso('');
      hint.textContent = <%- _js('Moves to the Deposited tab straight away — same caller stays. No follow-up needed.') %>;
    } else if (key === 'Fake') {
      setDateIso('');
      hint.textContent = <%- _js('This customer is deleted permanently, along with their remarks and calls.') %>;
    } else if (key === 'Do Not Contact') {
      setDateIso('');
      hint.textContent = <%- _js('This customer is removed from every calling list — no follow-up.') %>;
    } else if (Number.isFinite(days)) {
      setDateIso(addDays(todayISO(), days));
      hint.textContent = days <= 1
        ? <%- _js('Comes back tomorrow in My Calls.') %>
        : <%- _js('Comes back in {days} days. You can change the date below.') %>.replace('{days}', days);
    }
  }
</script>

<%- include('partials/foot') %>

