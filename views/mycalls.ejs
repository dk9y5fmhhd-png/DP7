<%- include('partials/head') %>

<div class="page-head">
  <div class="titles">
    <h1>My Calls</h1>
    <div class="sub">
      <%= helpers.prettyDateLong(today) %> · sirf <strong>aaj due</strong> wale customers.
      Jo aage ke liye rakhe hain wo apne din par khud wapas aayenge.
    </div>
  </div>
  <div class="chips">
    <a class="chip <%= showAll ? '' : 'on' %>" href="/calling/my"><%- icon('phone', 13) %> Aaj due</a>
    <a class="chip <%= showAll ? 'on' : '' %>" href="/calling/my?all=1"><%- icon('list', 13) %> Poori list</a>
  </div>
</div>

<div class="card" style="<%= target.complete ? 'border-color:rgba(70,211,154,0.45)' : '' %>">
  <div class="card-body">
    <div style="display:flex;align-items:flex-end;gap:14px;flex-wrap:wrap">
      <div style="flex:1 1 240px">
        <div class="label" style="font-size:11px;text-transform:uppercase;letter-spacing:0.08em;color:var(--fg-muted);font-weight:700">
          Aaj ka target
        </div>
        <div style="display:flex;align-items:baseline;gap:8px;margin-top:6px">
          <span style="font-size:34px;font-weight:800;letter-spacing:-0.02em;font-variant-numeric:tabular-nums;<%= target.complete ? 'color:var(--success)' : '' %>"><%= target.done %></span>
          <span style="font-size:18px;color:var(--fg-muted);font-weight:600">/ <%= target.target %></span>
          <% if (target.unlimited) { %>
            <span class="badge badge-neutral" style="margin-left:4px">koi limit nahi</span>
          <% } else if (target.complete) { %>
            <span class="badge badge-success" style="margin-left:4px"><%- icon('check', 12) %> Target poora</span>
          <% } else { %>
            <span class="badge badge-neutral" style="margin-left:4px"><%= target.remaining %> baaki</span>
          <% } %>
        </div>
      </div>
      <div style="flex:0 0 220px;text-align:right">
        <div class="muted tiny">Aaj kitne customer touch kiye</div>
        <div class="muted tiny">Queue me due: <strong><%= queueCount %></strong></div>
      </div>
    </div>

    <% if (!target.unlimited) { %>
    <div class="progress-track" style="margin-top:14px">
      <div class="progress-fill <%= target.complete ? 'done' : '' %>" style="width:<%= target.pct %>%"></div>
    </div>
    <div style="display:flex;justify-content:space-between;margin-top:6px" class="muted tiny">
      <span><%= target.pct %>% poora</span>
      <span><%= target.complete ? 'Shaabaash — aaj ka kaam khatam' : target.remaining + ' customers baaki' %></span>
    </div>
    <% } %>
  </div>
</div>

<div class="stat-grid">
  <div class="stat">
    <div class="label">Aaj due</div>
    <div class="value"><%= stats.due + stats.overdue %></div>
    <div class="hint">aaj + overdue · P1: <strong><%= stats.due_p1 %></strong></div>
  </div>
  <div class="stat <%= stats.overdue ? 'bad' : 'ok' %>">
    <div class="label">Overdue</div>
    <div class="value"><%= stats.overdue %></div>
    <div class="hint"><%= stats.overdue ? 'date nikal gayi — pehle inhe karein' : 'kuch pending nahi' %></div>
  </div>
  <div class="stat ok">
    <div class="label">Aaj ho gaya</div>
    <div class="value"><%= doneToday.remarks %></div>
    <div class="hint"><%= doneToday.customers %> customers</div>
  </div>
  <div class="stat">
    <div class="label">Aage ke liye rakhe</div>
    <div class="value"><%= stats.snoozed %></div>
    <div class="hint">apne din par list me aayenge</div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <h3><%- icon('phone', 15) %> <%= showAll ? 'Poori list' : 'Aaj ki list' %></h3>
    <span class="muted tiny" style="margin-left:auto">
      <% if (showAll || forceAll) { %>
        <%= rows.length %> customers · overdue sabse upar
      <% } else { %>
        <%= rows.length %> dikha rahe hain (target ke hisaab se)
      <% } %>
    </span>
  </div>

  <% if (!showAll && !forceAll && target.complete) { %>
    <div class="card-body" style="padding:26px 18px;text-align:center">
      <div style="font-size:30px;line-height:1">✅</div>
      <h3 style="margin:10px 0 6px">Aaj ka target poora — <%= target.done %> / <%= target.target %></h3>
      <p class="muted" style="margin:0 0 14px">
        Aapne aaj ke liye poora kaam kar liya. Kal wale customers aaj hi call karne ho to neeche se kholein —
        par pehle thoda aaram bhi kariye.
      </p>
      <a class="btn btn-primary" href="/calling/my?full=1">Phir bhi poori list dekhein (<%= queueCount %>)</a>
    </div>
  <% } %>
  <div class="table-wrapper">
    <table>
      <thead>
        <tr>
          <th>Customer</th>
          <th>Mobile</th>
          <th>VIP</th>
          <th>Priority</th>
          <th>Follow-up</th>
          <th class="right">Deposits</th>
          <th>Last remark</th>
          <th class="right">Action</th>
        </tr>
      </thead>
      <tbody>
        <% if (!rows.length) { %>
          <tr><td colspan="8"><div class="empty">
            <span class="big"><%- icon('check', 26) %></span>
            <% if (showAll) { %>
              Abhi koi customer assign nahi hua. Admin se kehiye.
            <% } else if (target.complete) { %>
              Target poora — upar se "poori list" khol sakte hain.
            <% } else { %>
              Aaj ka koi follow-up pending nahi. Shaabaash! 🎉
              <div class="muted tiny" style="margin-top:8px">Jo aage ke liye rakhe hain wo apne din par khud yahan aayenge.</div>
            <% } %>
          </div></td></tr>
        <% } %>
        <% if (hiddenCount > 0) { %>
          <tr><td colspan="8" style="text-align:center;background:rgba(245,197,66,0.05)">
            <span class="muted tiny">
              <strong><%= hiddenCount %></strong> customers aur due hain, par ye aaj ke target se bahar hain —
              kal ki list me sabse upar aayenge.
            </span>
          </td></tr>
        <% } %>
        <% rows.forEach(function (r) {
             const overdue = r.follow_up_on && r.days_late > 0;
             const ahead = r.follow_up_on && r.days_late < 0; %>
          <tr style="<%= overdue ? 'background:rgba(255,107,116,0.06)' : '' %>">
            <td class="who">
              <a href="/customers/<%= encodeURIComponent(r.username) %>"><strong><%= r.username %></strong></a>
              <% if (r.calls_today > 0) { %><span class="badge badge-info"><%= r.calls_today %> call</span><% } %>
            </td>
            <td class="num nowrap"><%= r.mobile_shown %></td>
            <td>
              <% if (r.vip_category !== 'normal') { %>
                <span class="badge <%= r.vip_category === 'high_value_vip' ? 'badge-accent' : (r.vip_category === 'premium_vip' ? 'badge-warn' : 'badge-success') %>">
                  <%= labels.VIP_LABEL[r.vip_category] %>
                </span>
              <% } else { %><span class="muted">—</span><% } %>
            </td>
            <td><span class="badge <%= r.priority === 'P1' ? 'badge-danger' : (r.priority === 'P2' ? 'badge-warn' : 'badge-neutral') %>"><%= r.priority %></span></td>
            <td class="nowrap">
              <% if (!r.follow_up_on) { %>
                <span class="badge badge-info">Naya</span>
              <% } else if (overdue) { %>
                <span class="badge badge-danger"><%= r.days_late %> din late</span>
                <div class="muted tiny"><%= helpers.prettyDate(r.follow_up_on) %></div>
              <% } else if (ahead) { %>
                <span class="badge badge-neutral"><%= -r.days_late %> din baad</span>
                <div class="muted tiny"><%= helpers.prettyDate(r.follow_up_on) %></div>
              <% } else { %>
                <span class="badge badge-success">Aaj</span>
              <% } %>
            </td>
            <td class="right num"><strong><%= r.deposit_count %></strong></td>
            <td class="muted tiny">
              <%= r.last_remark || '—' %>
              <% if (r.last_outcome) { %><div class="muted tiny"><%= r.last_outcome %></div><% } %>
            </td>
            <td class="right nowrap">
              <form method="post" action="/calls/call" style="display:inline;margin:0">
                <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                <input type="hidden" name="username" value="<%= r.username %>">
                <button class="btn btn-sm btn-primary" type="submit"><%- icon('phone', 13) %> Call</button>
              </form>
              <button class="btn btn-sm" type="button"
                      data-username="<%= r.username %>"
                      data-remark="<%= r.last_remark || '' %>"
                      onclick="openRemark(this)">Remark</button>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<% if (upcoming.length) { %>
  <div class="card">
    <div class="card-header">
      <h3><%- icon('clock', 15) %> Aage ke follow-ups</h3>
      <span class="muted tiny" style="margin-left:auto">agla din aate hi aaj ki list me aa jayenge</span>
    </div>
    <div class="table-wrapper">
      <table>
        <thead><tr><th>Customer</th><th>Agla follow-up</th><th>Kitne din baad</th><th>Last remark</th></tr></thead>
        <tbody>
          <% upcoming.forEach(function (u) { %>
            <tr>
              <td><a href="/customers/<%= encodeURIComponent(u.username) %>"><strong><%= u.username %></strong></a></td>
              <td class="nowrap"><strong><%= helpers.prettyDate(u.follow_up_on) %></strong></td>
              <td class="num"><%= u.in_days %> din</td>
              <td class="muted tiny"><%= u.last_remark || '—' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>

<dialog id="remarkDialog">
  <form method="post" action="/calling/remark">
    <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
    <input type="hidden" name="username" id="rm_username">
    <div class="dialog-head">
      <h3><%- icon('phone', 15) %> Remark</h3>
      <button type="button" class="close-x" onclick="document.getElementById('remarkDialog').close()">&times;</button>
    </div>
    <div class="dialog-body">
      <p class="muted tiny" style="margin:0 0 12px">Customer: <strong id="rm_who" style="color:var(--fg)"></strong></p>

      <div class="form-group">
        <label>Remark</label>
        <select name="action_type" id="rm_action" required onchange="guessDate()">
          <option value="">— chunein —</option>
          <% remarks.forEach(function (r) { %>
            <option value="<%= r.key %>" data-days="<%= r.days %>"><%= r.key %></option>
          <% }); %>
        </select>
        <span class="muted tiny" id="rm_hint">Remark chunne par agla follow-up khud lag jayega.</span>
      </div>

      <div class="form-group">
        <label>Agla follow-up <span class="muted tiny">(badalna ho to)</span></label>
        <div class="chips" style="margin-bottom:8px">
          <% quickDates.forEach(function (q) { %>
            <button type="button" class="chip" onclick="setGap(<%= q.days %>, this)"><%= q.label %></button>
          <% }); %>
        </div>
        <input type="hidden" name="follow_gap" id="rm_gap">
        <input type="date" name="follow_up_on" id="rm_fu" min="<%= today %>">
      </div>

      <div class="form-group">
        <label>Date (aaj)</label>
        <input type="date" name="action_date" value="<%= today %>" required>
      </div>
      <div class="form-group">
        <label>Note</label>
        <textarea name="response" rows="3" style="min-height:76px" placeholder="jaise: 2 din me deposit karega"></textarea>
      </div>
    </div>
    <div class="dialog-foot">
      <button type="button" class="btn btn-ghost" onclick="document.getElementById('remarkDialog').close()">Cancel</button>
      <button type="submit" class="btn btn-primary"><%- icon('check', 15) %> Save &amp; next</button>
    </div>
  </form>
</dialog>

<script>
  function openRemark(btn) {
    document.getElementById('rm_username').value = btn.dataset.username;
    document.getElementById('rm_who').textContent = btn.dataset.username;
    document.getElementById('rm_action').value = '';
    document.getElementById('rm_fu').value = '';
    document.getElementById('rm_gap').value = '';
    document.querySelectorAll('#remarkDialog .chip').forEach(function (c) { c.classList.remove('on'); });
    document.getElementById('rm_hint').textContent = 'Remark chunne par agla follow-up khud lag jayega.';
    document.getElementById('remarkDialog').showModal();
  }

  function todayISO() { return '<%= today %>'; }

  function addDays(iso, n) {
    var d = new Date(iso + 'T00:00:00Z');
    d.setUTCDate(d.getUTCDate() + n);
    return d.toISOString().slice(0, 10);
  }

  function setDateIso(iso) {
    document.getElementById('rm_fu').value = iso;
  }

  function setGap(days, chip) {
    document.getElementById('rm_gap').value = days;
    setDateIso(addDays(todayISO(), Number(days)));
    document.querySelectorAll('#remarkDialog .chip').forEach(function (c) { c.classList.remove('on'); });
    if (chip) chip.classList.add('on');
  }

  function guessDate() {
    var sel = document.getElementById('rm_action');
    var opt = sel.options[sel.selectedIndex];
    var days = opt ? Number(opt.dataset.days) : NaN;
    var key = opt ? opt.value : '';
    document.getElementById('rm_gap').value = '';
    document.querySelectorAll('#remarkDialog .chip').forEach(function (c) { c.classList.remove('on'); });

    if (key === 'Do Not Contact') {
      setDateIso('');
      document.getElementById('rm_hint').textContent = 'Is customer ko list se hata diya jayega — koi follow-up nahi.';
    } else if (Number.isFinite(days)) {
      setDateIso(addDays(todayISO(), days));
      document.getElementById('rm_hint').textContent = 'Agla follow-up: ' + days + ' din baad. Neeche se badal sakte hain.';
    }
  }
</script>

<%- include('partials/foot') %>

