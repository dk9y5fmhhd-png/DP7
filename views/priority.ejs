<%- include('partials/head') %>

<div class="page-head">
  <div class="titles">
    <h1>Calling List</h1>
    <div class="sub">
      <% if (isAdmin) { %>
        Priority ke hisaab se aaj kisko call karna hai — <strong>PD</strong> (ID bana, deposit nahi) sabse pehle.
        Ek customer sirf ek caller ke paas.
      <% } else { %>
        Aapko assign hue customers, priority ke hisaab se.
      <% } %>
    </div>
  </div>
  <div class="chips">
    <a class="chip" href="/calling/my"><%- icon('phone', 13) %> Aaj ka kaam</a>
    <a class="chip" href="/customers"><%- icon('team', 13) %> Customers</a>
  </div>
</div>

<div class="card">
  <div class="card-header" style="padding:10px 14px">
    <div class="chips">
      <% ['PD','P1','P2','P3'].forEach(function (p) { %>
        <% const c = counts.get(p) || { c: 0, free: 0 }; %>
        <a class="chip <%= priority === p ? 'on' : '' %>" href="/calling?p=<%= p %><%= filters.free ? '&free=1' : '' %>"
           <%= p === 'PD' && c.c ? 'style="border-color:rgba(245,197,66,0.55)"' : '' %>>
          <strong><%= p %></strong> · <%= c.c %> <span class="muted tiny">(<%= c.free %> free)</span>
        </a>
      <% }); %>
      <span class="muted tiny" style="align-self:center;margin-left:6px"><%= roleWeights[priority] %></span>
    </div>
  </div>
  <form method="get" action="/calling" class="filter-bar">
    <input type="hidden" name="p" value="<%= priority %>">
    <% if (isAdmin) { %>
    <div>
      <label>Caller</label>
      <select name="caller" data-autosubmit>
        <option value="">All callers</option>
        <% callers.forEach(function (c) { %>
          <option value="<%= c.id %>" <%= filters.caller === String(c.id) ? 'selected' : '' %>><%= c.name %></option>
        <% }); %>
      </select>
    </div>
    <div>
      <label>Assignment</label>
      <select name="free" data-autosubmit>
        <option value="">Sab</option>
        <option value="1" <%= filters.free ? 'selected' : '' %>>Sirf bina caller</option>
      </select>
    </div>
    <% } %>
    <div><button class="btn btn-primary" type="submit"><%- icon('search', 15) %> Dekhein</button></div>
    <div style="margin-left:auto" class="muted tiny align-self-center"><strong><%= rows.length %></strong> customers</div>
  </form>

  <form method="post" action="/customers/assign">
    <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
    <% if (isAdmin) { %>
    <div class="card-body" style="padding:12px 18px;border-bottom:1px solid var(--border);display:flex;gap:8px;align-items:center;flex-wrap:wrap">
      <span class="muted tiny">Chune hue customers ko:</span>
      <select name="caller_id" style="min-width:170px">
        <option value="">— caller hatao —</option>
        <% callers.forEach(function (c) { %><option value="<%= c.id %>"><%= c.name %></option><% }); %>
      </select>
      <button class="btn btn-sm btn-primary" type="submit">Assign</button>
      <span class="muted tiny" style="margin-left:auto">Mobile masked hai — call button se dial karein</span>
    </div>
    <% } else { %>
    <div class="card-body" style="padding:10px 18px;border-bottom:1px solid var(--border)">
      <span class="muted tiny">Aapke assigned customers · number masked hai — Call button se dial karein</span>
    </div>
    <% } %>

    <div class="table-wrapper">
      <table>
        <thead>
          <tr>
            <% if (isAdmin) { %><th style="width:36px"><input type="checkbox" data-check-all></th><% } %>
            <th>Customer</th>
            <th>Mobile</th>
            <th>VIP</th>
            <th>Status</th>
            <th class="right">Deposits</th>
            <th class="right">Inactive</th>
            <th>Last remark</th>
            <th>Follow-up</th>
            <th>Caller</th>
            <th class="right">Action</th>
          </tr>
        </thead>
        <tbody data-check-scope>
          <% if (!rows.length) { %>
            <tr><td colspan="11"><div class="empty"><span class="big"><%- icon('check', 26) %></span>Is list me koi customer nahi.</div></td></tr>
          <% } %>
          <% rows.forEach(function (r) { %>
            <tr>
              <% if (isAdmin) { %><td><input type="checkbox" name="username" value="<%= r.username %>" data-checkable></td><% } %>
              <td class="who"><a href="/customers/<%= encodeURIComponent(r.username) %>"><strong><%= r.username %></strong></a>
                <% if (r.do_not_contact) { %><span class="badge badge-danger">DNC</span><% } %>
              </td>
              <td class="num nowrap"><%= r.mobile_shown %></td>
              <td>
                <% if (r.vip_category !== 'normal') { %>
                  <span class="badge <%= r.vip_category === 'high_value_vip' ? 'badge-accent' : (r.vip_category === 'premium_vip' ? 'badge-warn' : 'badge-success') %>">
                    <%= labels.VIP_LABEL[r.vip_category] %>
                  </span>
                <% } else { %><span class="muted">—</span><% } %>
              </td>
              <td><span class="badge <%= r.status === 'inactive' ? 'badge-danger' : (r.status === 'new' ? 'badge-info' : 'badge-success') %>"><%= r.status %></span></td>
              <td class="right num"><strong><%= r.deposit_count %></strong></td>
              <td class="right num"><%= r.days_inactive < 9999 ? r.days_inactive + 'd' : '—' %></td>
              <td class="muted tiny"><%= r.last_remark || '—' %></td>
              <td class="nowrap tiny">
                <% if (!r.follow_up_on) { %><span class="muted">—</span>
                <% } else if (r.follow_up_on < today) { %>
                  <span class="badge badge-danger"><%= helpers.prettyDate(r.follow_up_on) %></span>
                <% } else { %>
                  <span class="muted"><%= helpers.prettyDate(r.follow_up_on) %></span>
                <% } %>
              </td>
              <td class="tiny"><% if (r.caller_name) { %><%= r.caller_name %><% } else { %><span class="muted">free</span><% } %></td>
              <td class="right nowrap">
                <form method="post" action="/calls/call" style="display:inline;margin:0">
                  <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                  <input type="hidden" name="username" value="<%= r.username %>">
                  <button class="btn btn-sm btn-primary" type="submit"><%- icon('phone', 13) %></button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </form>
</div>

<%- include('partials/foot') %>

