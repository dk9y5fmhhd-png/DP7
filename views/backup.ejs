<%- include('partials/head') %>

<div class="page-head">
  <div class="titles">
    <h1><%- _th('Backup &amp; Export') %></h1>
    <div class="sub"><%= _t('Keep the data with you — the CSV opens straight in Excel.') %></div>
  </div>
</div>

<div class="stat-grid">
  <div class="stat">
    <div class="label"><%= _t('Deposit rows') %></div>
    <div class="value"><%= Number(stats.deposits).toLocaleString('en-IN') %></div>
    <div class="hint"><%= _t('total entries') %></div>
  </div>
  <div class="stat">
    <div class="label"><%= _t('Clients') %></div>
    <div class="value"><%= Number(stats.clients).toLocaleString('en-IN') %></div>
    <div class="hint"><%= _t('unique usernames') %></div>
  </div>
  <div class="stat">
    <div class="label"><%= _t('Follow-ups') %></div>
    <div class="value"><%= Number(stats.followups).toLocaleString('en-IN') %></div>
    <div class="hint"><%= _t('logged') %></div>
  </div>
  <div class="stat">
    <div class="label"><%= _t('Users') %></div>
    <div class="value"><%= Number(stats.users).toLocaleString('en-IN') %></div>
    <div class="hint"><%= _t('staff accounts') %></div>
  </div>
</div>

<div class="card">
  <div class="card-header"><h3><%- icon('download', 15) %> <%= _t('Download') %></h3>
    <span class="muted tiny" style="margin-left:auto"> <%= _t('Data range: {n} → {n2}', { n: (stats.first_date ? helpers.prettyDate(stats.first_date) : '—'), n2: (stats.last_date ? helpers.prettyDate(stats.last_date) : '—') }) %>
    </span>
  </div>
  <div class="card-body">
    <div class="chips">
      <a class="chip" href="/backup/export/deposits"><%- icon('download', 13) %> <%= _t('Deposits (CSV)') %></a>
      <a class="chip" href="/backup/export/clients"><%- icon('download', 13) %> <%= _t('Clients + totals (CSV)') %></a>
      <a class="chip" href="/backup/export/followups"><%- icon('download', 13) %> <%= _t('Follow-ups (CSV)') %></a>
      <a class="chip" href="/backup/export/settings"><%- icon('download', 13) %> <%= _t('Settings + levels (JSON)') %></a>
    </div>
    <p class="muted tiny" style="margin:14px 0 0"><%= _t('Download the "Deposits" CSV once a week and keep it on your own drive or pen drive.') %></p>
  </div>
</div>

<div class="grid-2">
  <div class="card">
    <div class="card-header"><h3><%- icon('clock', 15) %> <%= _t('Last 20 days') %></h3></div>
    <div class="table-wrapper">
      <table>
        <thead><tr><th><%= _t('Date') %></th><th class="right"><%= _t('Rows') %></th><th class="right"><%= _t('Amount') %></th></tr></thead>
        <tbody>
          <% days.forEach(function (d) { %>
            <tr><td class="nowrap"><strong><%= d.d %></strong></td><td class="num right"><%= d.entries %></td><td class="money right"><%= helpers.money(d.amount) %></td></tr>
          <% }); %>
          <% if (!days.length) { %><tr><td colspan="3"><div class="empty"><%= _t('No data.') %></div></td></tr><% } %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="card">
    <div class="card-header"><h3><%- icon('alert', 15) %> <%= _t('Delete a day') %></h3></div>
    <form method="post" action="/backup/delete-day">
      <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
      <div class="card-body">
        <div class="form-group">
          <label><%= _t('Date') %></label>
          <input type="date" name="play_date" required>
        </div>
        <div class="form-group">
          <label><%= _t('T-PIN') %></label>
          <input type="password" name="pin" required autocomplete="off" placeholder="••••••">
        </div>
      </div>
      <div class="card-footer" style="text-align:right">
        <button type="submit" class="btn btn-danger" data-confirm="<%= _t('All data for that day will be deleted. Confirm?') %>">
          <%- icon('x', 15) %> <%= _t('Delete day') %> </button>
      </div>
    </form>
  </div>
</div>

<%- include('partials/foot') %>

