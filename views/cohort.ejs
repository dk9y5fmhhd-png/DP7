<%- include('partials/head') %>

<div class="page-head">
  <div class="titles">
    <h1><%= data.meta.title %></h1>
    <div class="sub">
      <%
        const th = data.thresholds;
        const minDays = data.meta.key === 'daily' ? th.daily
                      : data.meta.key === 'biweekly' ? th.byweekly
                      : data.meta.key === 'weekly' ? th.weekly
                      : null;
      %>
      <strong><%= data.period.label %></strong> ·
      <%= data.meta.blurb %>
      <% if (minDays !== null) { %>— <%= minDays %>+ days per week<% } else { %>— under <%= th.weekly %> days per week<% } %>
      (pichhle <%= data.weeks %> hafte, <%= helpers.prettyDate(data.lookbackStart) %> – <%= helpers.prettyDate(data.lookbackEnd) %>)
    </div>
  </div>
  <div class="chips">
    <a class="chip" href="/reports/<%= data.meta.key %>?d=<%= prevAnchor %><%= filters.dups ? '&dups=1' : '' %>" title="Pichhla period"><%- icon('left', 13) %></a>
    <a class="chip" href="/reports/<%= data.meta.key %>?d=<%= nextAnchor %><%= filters.dups ? '&dups=1' : '' %>" title="Agla period"><%- icon('right', 13) %></a>
    <% if (user.role === 'super_admin') { %>
    <a class="chip" href="/reports/export?type=<%= data.meta.key %>&d=<%= filters.d %>"><%- icon('download', 13) %> CSV</a>
    <a class="chip" href="#" data-print><%- icon('file', 13) %> Print</a>
    <% } %>
  </div>
</div>

<div class="stat-grid">
  <div class="stat bad">
    <div class="label">Gone quiet</div>
    <div class="value"><%= data.summary.quiet.toLocaleString('en-IN') %></div>
    <div class="hint">is period me deposit nahi kiya</div>
  </div>
  <div class="stat">
    <div class="label">In this group</div>
    <div class="value"><%= data.summary.total.toLocaleString('en-IN') %></div>
    <div class="hint">habit ke hisaab se</div>
  </div>
  <div class="stat ok">
    <div class="label">Deposited</div>
    <div class="value"><%= data.summary.deposited.toLocaleString('en-IN') %></div>
    <div class="hint">list se hidden</div>
  </div>
  <div class="stat <%= data.dupes.size ? 'warn' : '' %>">
    <div class="label">Duplicate numbers</div>
    <div class="value"><%= data.dupes.size.toLocaleString('en-IN') %></div>
    <div class="hint">is list me</div>
  </div>
</div>

<div class="card">
  <form method="get" action="/reports/<%= data.meta.key %>" class="filter-bar">
    <div>
      <label><%= data.meta.key === 'daily' ? 'Day' : (data.meta.key === 'monthly' ? 'Month (koi bhi date)' : 'Week (koi bhi date)') %></label>
      <input type="date" name="d" value="<%= filters.d %>">
    </div>
    <div>
      <label>Duplicates</label>
      <label class="check-pill" style="height:36px">
        <input type="checkbox" name="dups" value="1" <%= filters.dups ? 'checked' : '' %>> Only duplicate numbers
      </label>
    </div>
    <div><button type="submit" class="btn btn-primary"><%- icon('search', 15) %> Search</button></div>
    <div><a href="/reports/<%= data.meta.key %>" class="btn btn-outline"><%- icon('refresh', 15) %> Reset</a></div>
    <div style="margin-left:auto" class="muted tiny">
      Total quiet: <strong><%= data.total.toLocaleString('en-IN') %></strong>
    </div>
  </form>

  <div class="table-wrapper">
    <table>
      <thead>
        <tr>
          <th>Username</th>
          <th>Mobile Number</th>
          <th>Level</th>
          <th>Regularity</th>
          <th>Last Deposit</th>
          <th>Remark</th>
          <th>Follow-up</th>
          <th class="right">Action</th>
        </tr>
      </thead>
      <tbody>
        <% if (!data.rows.length) { %>
          <tr><td colspan="8">
            <div class="empty">
              <span class="big"><%- icon('check', 30) %></span>
              Is period me is group ka koi client quiet nahi hua — sab deposit kar rahe hain.
            </div>
          </td></tr>
        <% } %>
        <% data.grouped.forEach(function (g) { %>
          <tr class="row-group">
            <td colspan="8">
              deposited <%= g.label %> days a week · <%= g.rows.length %> client<%= g.rows.length === 1 ? '' : 's' %>
            </td>
          </tr>
          <% g.rows.forEach(function (r) { %>
            <tr>
              <td class="who"><strong><%= r.username %></strong>
                <div class="muted tiny"><%= helpers.money(r.total_deposited) %> · <%= r.deposit_count %> deposits</div>
              </td>
              <td class="num nowrap">
                <%= mask(r.mobile) %>
                <% if (r.dupeCount > 1) { %><span class="badge badge-warn">×<%= r.dupeCount %></span><% } %>
              </td>
              <td><span class="badge <%= r.levelClass %>"><%= r.levelName || 'No level' %></span></td>
              <td class="nowrap"><strong class="num"><%= r.perWeek.toFixed(1) %></strong> <span class="muted tiny">days/wk</span></td>
              <td class="nowrap">
                <%= r.last_deposit %>
                <span class="muted tiny" style="display:block"><%= helpers.relativeDays(r.last_deposit, helpers.today()) %></span>
              </td>
              <td><div class="note <%= r.followup && r.followup.response ? '' : 'muted' %>" title="<%= r.followup && r.followup.response ? r.followup.response : '' %>"><%= r.followup && r.followup.response ? r.followup.response : '—' %></div></td>
              <td>
                <% if (r.followup) { %>
                  <span class="badge badge-neutral"><%= r.followup.action_type %></span>
                  <span class="muted tiny" style="display:block;margin-top:3px"><%= r.followup.action_date %></span>
                <% } else { %><span class="muted">—</span><% } %>
              </td>
              <td class="right">
                <button type="button" class="btn btn-sm" onclick="openFollowup('<%= r.username.replace(/'/g, "\\'") %>')">
                  <%- icon('phone', 13) %> Follow-up
                </button>
              </td>
            </tr>
          <% }); %>
        <% }); %>
      </tbody>
    </table>
  </div>

  <div class="card-footer pagination">
    <span class="page-info">Page <%= data.page %> of <%= data.pages %></span>
    <% if (data.page > 1) { %>
      <a class="btn btn-sm" href="/reports/<%= data.meta.key %>?d=<%= filters.d %><%= filters.dups ? '&dups=1' : '' %>&page=<%= data.page - 1 %>"><%- icon('left', 14) %> Prev</a>
    <% } %>
    <% if (data.page < data.pages) { %>
      <a class="btn btn-sm" href="/reports/<%= data.meta.key %>?d=<%= filters.d %><%= filters.dups ? '&dups=1' : '' %>&page=<%= data.page + 1 %>">Next <%- icon('right', 14) %></a>
    <% } %>
  </div>
</div>

<%- include('partials/foot') %>



