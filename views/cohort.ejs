<%- include('partials/head') %>

<div class="page-head">
  <div class="titles">
    <h1><%= _t(data.meta.title) %></h1>
    <div class="sub">
      <%
        const th = data.thresholds;
        const minDays = data.meta.key === 'daily' ? th.daily
                      : data.meta.key === 'biweekly' ? th.byweekly
                      : data.meta.key === 'weekly' ? th.weekly
                      : null;
      %>
      <strong><%= _t(data.period.label) %></strong> ·
      <%= _t(data.meta.blurb) %>
      <% if (minDays !== null) { %><%= _t('— {minDays}+ days per week', { minDays: (minDays) }) %><% } else { %><%= _t('— under {weekly} days per week', { weekly: (th.weekly) }) %><% } %> <%= _t('(last {weeks} weeks, {lookbackStart} – {lookbackEnd})', { weeks: (data.weeks), lookbackStart: (helpers.prettyDate(data.lookbackStart)), lookbackEnd: (helpers.prettyDate(data.lookbackEnd)) }) %> </div>
  </div>
  <div class="chips">
    <a class="chip" href="/reports/<%= data.meta.key %>?d=<%= prevAnchor %><%= filters.dups ? '&dups=1' : '' %>" title="<%= _t('Previous period') %>"><%- icon('left', 13) %></a>
    <a class="chip" href="/reports/<%= data.meta.key %>?d=<%= nextAnchor %><%= filters.dups ? '&dups=1' : '' %>" title="<%= _t('Next period') %>"><%- icon('right', 13) %></a>
    <% if (user.role === 'super_admin') { %>
    <a class="chip" href="/reports/export?type=<%= data.meta.key %>&d=<%= filters.d %>"><%- icon('download', 13) %> CSV</a>
    <a class="chip" href="#" data-print><%- icon('file', 13) %> <%= _t('Print') %></a>
    <% } %>
  </div>
</div>

<div class="stat-grid">
  <div class="stat bad">
    <div class="label"><%= _t('Gone quiet') %></div>
    <div class="value"><%= data.summary.quiet.toLocaleString('en-IN') %></div>
    <div class="hint"><%= _t('did not deposit in this period') %></div>
  </div>
  <div class="stat">
    <div class="label"><%= _t('In this group') %></div>
    <div class="value"><%= data.summary.total.toLocaleString('en-IN') %></div>
    <div class="hint"><%= _t('against their usual habit') %></div>
  </div>
  <div class="stat ok">
    <div class="label"><%= _t('Deposited') %></div>
    <div class="value"><%= data.summary.deposited.toLocaleString('en-IN') %></div>
    <div class="hint"><%= _t('hidden from the list') %></div>
  </div>
  <div class="stat <%= data.dupes.size ? 'warn' : '' %>">
    <div class="label"><%= _t('Duplicate numbers') %></div>
    <div class="value"><%= data.dupes.size.toLocaleString('en-IN') %></div>
    <div class="hint"><%= _t('in this list') %></div>
  </div>
</div>

<div class="card">
  <form method="get" action="/reports/<%= data.meta.key %>" class="filter-bar">
    <div>
      <label><%= data.meta.key === 'daily' ? _t('Day') : (data.meta.key === 'monthly' ? _t('Month (any date)') : _t('Week (any date)')) %></label>
      <input type="date" name="d" value="<%= filters.d %>">
    </div>
    <div>
      <label><%= _t('Duplicates') %></label>
      <label class="check-pill" style="height:36px">
        <input type="checkbox" name="dups" value="1" <%= filters.dups ? 'checked' : '' %>> <%= _t('Only duplicate numbers') %> </label>
    </div>
    <div><button type="submit" class="btn btn-primary"><%- icon('search', 15) %> <%= _t('Search') %></button></div>
    <div><a href="/reports/<%= data.meta.key %>" class="btn btn-outline"><%- icon('refresh', 15) %> <%= _t('Reset') %></a></div>
    <div style="margin-left:auto" class="muted tiny"> <%- _th('Total quiet: <strong>{total}</strong>', { total: (data.total.toLocaleString('en-IN')) }) %>
    </div>
  </form>

  <div class="table-wrapper">
    <table>
      <thead>
        <tr>
          <th><%= _t('Username') %></th>
          <th><%= _t('Mobile Number') %></th>
          <th><%= _t('Level') %></th>
          <th><%= _t('Regularity') %></th>
          <th><%= _t('Last Deposit') %></th>
          <th><%= _t('Remark') %></th>
          <th><%= _t('Follow-up') %></th>
          <th class="right"><%= _t('Action') %></th>
        </tr>
      </thead>
      <tbody>
        <% if (!data.rows.length) { %>
          <tr><td colspan="8">
            <div class="empty">
              <span class="big"><%- icon('check', 30) %></span><%= _t('No client in this group went quiet — everyone is depositing.') %></div>
          </td></tr>
        <% } %>
        <% data.grouped.forEach(function (g) { %>
          <tr class="row-group">
            <td colspan="8"> <%= _t('deposited {label} days a week · {n} clients', { label: (g.label), n: (g.rows.length) }) %> </td>
          </tr>
          <% g.rows.forEach(function (r) { %>
            <tr>
              <td class="who"><strong><%= r.username %></strong>
                <div class="muted tiny"><%= _t('{total_deposited} · {deposit_count} deposits', { total_deposited: (helpers.money(r.total_deposited)), deposit_count: (r.deposit_count) }) %></div>
              </td>
              <td class="num nowrap">
                <%= mask(r.mobile) %>
                <% if (r.dupeCount > 1) { %><span class="badge badge-warn">×<%= r.dupeCount %></span><% } %>
              </td>
              <td><span class="badge <%= r.levelClass %>"><%= r.levelName || _t('No level') %></span></td>
              <td class="nowrap"><strong class="num"><%= r.perWeek.toFixed(1) %></strong> <span class="muted tiny"><%= _t('days/wk') %></span></td>
              <td class="nowrap">
                <%= r.last_deposit %>
                <span class="muted tiny" style="display:block"><%= helpers.relativeDays(r.last_deposit, helpers.today()) %></span>
              </td>
              <td><div class="note <%= r.followup && r.followup.response ? '' : 'muted' %>" title="<%= r.followup && r.followup.response ? r.followup.response : '' %>"><%= r.followup && r.followup.response ? r.followup.response : '—' %></div></td>
              <td>
                <% if (r.followup) { %>
                  <span class="badge badge-neutral"><%= _t(r.followup.action_type) %></span>
                  <span class="muted tiny" style="display:block;margin-top:3px"><%= r.followup.action_date %></span>
                <% } else { %><span class="muted">—</span><% } %>
              </td>
              <td class="right">
                <button type="button" class="btn btn-sm" onclick="openFollowup('<%= r.username.replace(/'/g, "\\'") %>')">
                  <%- icon('phone', 13) %> <%= _t('Follow-up') %> </button>
              </td>
            </tr>
          <% }); %>
        <% }); %>
      </tbody>
    </table>
  </div>

  <div class="card-footer pagination">
    <span class="page-info"><%= _t('Page {page} of {pages}', { page: (data.page), pages: (data.pages) }) %></span>
    <% if (data.page > 1) { %>
      <a class="btn btn-sm" href="/reports/<%= data.meta.key %>?d=<%= filters.d %><%= filters.dups ? '&dups=1' : '' %>&page=<%= data.page - 1 %>"><%- icon('left', 14) %> <%= _t('Prev') %></a>
    <% } %>
    <% if (data.page < data.pages) { %>
      <a class="btn btn-sm" href="/reports/<%= data.meta.key %>?d=<%= filters.d %><%= filters.dups ? '&dups=1' : '' %>&page=<%= data.page + 1 %>"><%= _t('Next') %> <%- icon('right', 14) %></a>
    <% } %>
  </div>
</div>

<%- include('partials/foot') %>



