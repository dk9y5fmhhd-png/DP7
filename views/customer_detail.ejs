<%- include('partials/head') %>

<div class="page-head">
  <div class="titles">
    <h1><%= c.username %></h1>
    <div class="sub">
      <span class="badge <%= c.status === 'active' ? 'badge-success' : (c.status === 'inactive' ? 'badge-danger' : 'badge-info') %>"><%= _t(labels.STATUS_LABEL[c.status]) %></span>
      <% if (c.vip_category !== 'normal') { %>
        <span class="badge badge-accent"><%= _t(labels.VIP_LABEL[c.vip_category]) %></span>
      <% } %>
      <span class="badge badge-neutral"><%= c.priority %></span>
      <% if (c.caller_name) { %> <%- _th('· Caller: <strong>{caller_name}</strong>', { caller_name: (c.caller_name) }) %><% } else { %> · <span class="muted"><%= _t('unassigned') %></span><% } %>
    </div>
  </div>
  <div class="chips">
    <a class="chip" href="/customers"><%- icon('left', 13) %> <%= _t('Customers') %></a>
    <form method="post" action="/calls/call" style="margin:0">
      <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
      <input type="hidden" name="username" value="<%= c.username %>">
      <button class="chip" type="submit" data-dial="<%= c.username %>" data-mobile="<%= mobileShown %>" <%= c.do_not_contact ? 'disabled' : '' %>><%- icon('phone', 13) %> <%= _t('Call') %></button>
    </form>
    <% if (can('whatsapp') && !c.do_not_contact) { %><a class="chip" href="/whatsapp/customer/<%= encodeURIComponent(c.username) %>" data-wa><span style="color:#25D366"><%- icon('whatsapp', 13) %></span> WhatsApp</a><% } %>
  </div>
</div>

<div class="stat-grid">
  <div class="stat"><div class="label"><%= _t('Deposits') %></div><div class="value"><%= c.deposit_count %></div><div class="hint"><%= _t('successful only') %></div></div>
  <div class="stat ok"><div class="label"><%= _t('Lifetime total') %></div><div class="value"><%= helpers.money(c.deposit_amount) %></div><div class="hint"><%= _t('deposited') %></div></div>
  <div class="stat"><div class="label"><%= _t('First deposit') %></div><div class="value" style="font-size:17px"><%= c.first_deposit || '—' %></div><div class="hint"><%= _t('first time') %></div></div>
  <div class="stat <%= c.status === 'inactive' ? 'bad' : '' %>">
    <div class="label"><%= _t('Last deposit') %></div>
    <div class="value" style="font-size:17px"><%= c.last_deposit || '—' %></div>
    <div class="hint"><%= c.days_inactive < 9999 ? c.days_inactive + _t(' days ago') : _t('never') %></div>
  </div>
  <div class="stat"><div class="label"><%= _t('Mobile') %></div><div class="value" style="font-size:17px"><%= mobileShown %></div><div class="hint"><%= canSeeFull ? _t('full number') : _t('masked') %></div></div>
</div>

<div class="grid-2">
  <div class="card">
    <div class="card-header"><h3><%- icon('money', 15) %> <%= _t('Deposit history') %></h3>
      <span class="muted tiny" style="margin-left:auto"><%= _t('{n} rows', { n: (deposits.length) }) %></span>
    </div>
    <div class="table-wrapper">
      <table>
        <thead><tr><th><%= _t('Date') %></th><th class="right"><%= _t('Amount') %></th><th><%= _t('Status') %></th><th><%= _t('Txn') %></th></tr></thead>
        <tbody>
          <% if (!deposits.length) { %><tr><td colspan="4"><div class="empty"><%= _t('No deposits.') %></div></td></tr><% } %>
          <% deposits.forEach(function (d) { %>
            <tr>
              <td class="nowrap"><strong><%= d.d %></strong></td>
              <td class="money right"><%= helpers.money(d.amount) %></td>
              <td>
                <span class="badge <%= d.status === 'successful' ? 'badge-success' : (d.status === 'failed' ? 'badge-danger' : 'badge-warn') %>"><%= _t(d.status) %></span>
              </td>
              <td class="muted tiny"><%= d.txn_id || '—' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="card">
    <div class="card-header"><h3><%- icon('phone', 15) %> <%= _t('Remarks') %></h3>
      <span class="muted tiny" style="margin-left:auto"><%= remarks.length %></span>
    </div>
    <div class="table-wrapper">
      <table>
        <thead><tr><th><%= _t('Date') %></th><th><%= _t('Remark') %></th><th><%= _t('Note') %></th><th><%= _t('By') %></th></tr></thead>
        <tbody>
          <% if (!remarks.length) { %><tr><td colspan="4"><div class="empty"><%= _t('No remarks.') %></div></td></tr><% } %>
          <% remarks.forEach(function (f) { %>
            <tr>
              <td class="nowrap muted tiny"><%= f.action_date %></td>
              <td><span class="badge badge-accent"><%= _t(f.action_type) %></span>
                <% if (f.next_action) { %><div class="muted tiny"><%= _t(f.next_action) %></div><% } %>
              </td>
              <td class="tiny"><%= f.response || '—' %></td>
              <td class="muted tiny"><%= f.by_name || '—' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header"><h3><%- icon('clock', 15) %> <%= _t('Call log') %></h3></div>
  <div class="table-wrapper">
    <table>
      <thead><tr><th><%= _t('When') %></th><th><%= _t('Caller') %></th><th><%= _t('Provider') %></th><th><%= _t('Status') %></th><th class="right"><%= _t('Duration') %></th><th><%= _t('Note') %></th></tr></thead>
      <tbody>
        <% if (!calls.length) { %><tr><td colspan="6"><div class="empty"><%= _t('No calls.') %></div></td></tr><% } %>
        <% calls.forEach(function (k) { %>
          <tr>
            <td class="nowrap muted tiny"><%= helpers.prettyDateTime(k.called_at) %></td>
            <td><%= k.caller_name || '—' %></td>
            <td><span class="badge badge-neutral"><%= k.provider %></span></td>
            <td class="tiny"><%= _t(k.status) %></td>
            <td class="right num"><%= k.duration_sec || 0 %>s</td>
            <td class="muted tiny"><%= k.note || '—' %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<div class="grid-2">
  <div class="card">
    <div class="card-header"><h3><%- icon('phone', 15) %><%= _t('Add remark') %></h3></div>
    <form method="post" action="/calling/remark">
      <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
      <input type="hidden" name="username" value="<%= c.username %>">
      <div class="card-body">
        <div class="form-group">
          <label><%= _t('Remark') %></label>
          <select name="action_type" required>
            <option value=""><%= _t('— choose —') %></option>
            <% REMARKS.forEach(function (r) { %>
              <option value="<%= r.key %>"><%= _t(r.key) %> → <%= _t(r.next) %></option>
            <% }); %>
          </select>
        </div>
        <div class="form-group"><label><%= _t('Date') %></label><input type="date" name="action_date" value="<%= today %>"></div>
        <div class="form-group"><label><%= _t('Note') %></label><textarea name="response" rows="3" style="min-height:80px" placeholder="<%= _t('what was discussed on the call…') %>"></textarea></div>
      </div>
      <div class="card-footer" style="text-align:right">
        <button class="btn btn-primary" type="submit"><%- icon('check', 15) %> <%= _t('Save remark') %></button>
      </div>
    </form>
  </div>

  <% if (isAdmin) { %>
  <div class="card">
    <div class="card-header"><h3><%- icon('team', 15) %> <%= _t('Assign caller') %></h3></div>
    <form method="post" action="/customers/assign">
      <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
      <input type="hidden" name="username" value="<%= c.username %>">
      <div class="card-body">
        <div class="form-group">
          <label><%= _t('Caller') %></label>
          <select name="caller_id">
            <option value=""><%= _t('— none —') %></option>
            <% callers.forEach(function (u) { %>
              <option value="<%= u.id %>" <%= c.assigned_to === u.id ? 'selected' : '' %>><%= u.name %></option>
            <% }); %>
          </select>
          <span class="muted tiny"><%= _t('Each customer stays with one caller.') %></span>
        </div>
        <div class="form-group">
          <label><%= _t('Do Not Contact') %></label>
          <span class="muted tiny" style="display:block;margin-bottom:6px">
            <%= c.do_not_contact ? _t('This customer is currently suppressed — they will not appear in any call list.') : _t('Marking this hides the customer from every calling list.') %>
          </span>
        </div>
      </div>
      <div class="card-footer" style="display:flex;justify-content:space-between;align-items:center">
        <button class="btn btn-sm <%= c.do_not_contact ? 'btn-success' : 'btn-danger' %>" type="submit"
                formaction="/customers/<%= c.id %>/flags" formmethod="post"
                name="do_not_contact" value="<%= c.do_not_contact ? '0' : '1' %>">
          <%= c.do_not_contact ? _t('Back to the call list') : _t('Do Not Contact') %>
        </button>
        <button class="btn btn-primary" type="submit"><%- icon('check', 15) %> <%= _t('Assign') %></button>
      </div>
    </form>
  </div>
  <% } %>
</div>

<% if (isAdmin) { %>
<div class="card" style="border-color:rgba(255,90,118,0.35)">
  <div class="card-header" style="background:rgba(255,90,118,0.07)">
    <h3><%- icon('trash', 15) %> <%= _t('Delete this customer') %></h3>
  </div>
  <form method="post" action="/customers/<%= c.id %>/delete">
    <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
    <input type="hidden" name="back" value="detail">
    <div class="card-body" style="display:flex;align-items:center;gap:14px;flex-wrap:wrap">
      <p class="muted tiny" style="margin:0;flex:1 1 260px">
        <%- _th('<strong>{username}</strong> master record, all remarks and the call log are deleted. Deposit rows are separate — to clear those too, first use', { username: (c.username) }) %><a href="/upload"><%= _t('Daily Upload') %></a><%= _t('to remove them as well.') %></p>
      <button class="btn btn-danger" type="submit"
              data-confirm="<%= _t('Permanently delete {username}?', { username: (c.username) }) %>">
        <%- icon('trash', 15) %> <%= _t('Customer delete') %> </button>
    </div>
  </form>
</div>
<% } %>

<%- include('partials/foot') %>


