<%- include('partials/head') %>

<div class="page-head">
  <div class="titles">
    <h1><%= _t('Level Report') %></h1>
    <div class="sub"> <%- _th('Ranked by lifetime deposits. Active = deposit after {cutoff}. <strong>Deposits</strong> = number of rows, <strong>Level</strong> = by total amount', { cutoff: (helpers.prettyDate(data.cutoff)) }) %></div>
  </div>
  <div class="chips">
    <% if (user.role === 'super_admin') { %>
    <a class="chip" href="/reports/export?type=level<%= filters.level ? '&level=' + filters.level : '' %>"><%- icon('download', 13) %> CSV</a>
    <a class="chip" href="#" data-print><%- icon('file', 13) %> <%= _t('Print') %></a>
    <% } %>
  </div>
</div>

<div class="stat-grid">
  <div class="stat">
    <div class="label"><%= _t('Clients') %></div>
    <div class="value"><%= data.total.toLocaleString('en-IN') %></div>
    <div class="hint"><%= _t('in this filter') %></div>
  </div>
  <div class="stat <%= data.unbanded ? 'warn' : 'ok' %>">
    <div class="label"><%= _t('Unbanded') %></div>
    <div class="value"><%= data.unbanded.toLocaleString('en-IN') %></div>
    <div class="hint"><%= _t('fall in no level') %></div>
  </div>
  <div class="stat bad">
    <div class="label"><%= _t('Duplicate mobiles') %></div>
    <div class="value"><%= data.dupes.size.toLocaleString('en-IN') %></div>
    <div class="hint"><%= _t('same number, 2+ clients') %></div>
  </div>
</div>

<div class="card">
  <form method="get" action="/reports/level" class="filter-bar">
    <div>
      <label><%= _t('Level') %></label>
      <select name="level" data-autosubmit>
        <option value=""><%= _t('All levels') %></option>
        <% levels.forEach(function (l) { %>
          <option value="<%= l.id %>" <%= String(filters.level) === String(l.id) ? 'selected' : '' %>><%= l.name %></option>
        <% }); %>
      </select>
    </div>
    <div>
      <label><%= _t('Sort by') %></label>
      <select name="sort" data-autosubmit>
        <option value="total_desc" <%= filters.sort === 'total_desc' ? 'selected' : '' %>><%= _t('Total deposited (high → low)') %></option>
        <option value="total_asc" <%= filters.sort === 'total_asc' ? 'selected' : '' %>><%= _t('Total deposited (low → high)') %></option>
        <option value="count_desc" <%= filters.sort === 'count_desc' ? 'selected' : '' %>><%= _t('No. of deposits (high → low)') %></option>
        <option value="count_asc" <%= filters.sort === 'count_asc' ? 'selected' : '' %>><%= _t('No. of deposits (low → high)') %></option>
        <option value="days_desc" <%= filters.sort === 'days_desc' ? 'selected' : '' %>><%= _t('Active days (high → low)') %></option>
        <option value="user_asc" <%= filters.sort === 'user_asc' ? 'selected' : '' %>><%= _t('Username (A → Z)') %></option>
        <option value="user_desc" <%= filters.sort === 'user_desc' ? 'selected' : '' %>><%= _t('Username (Z → A)') %></option>
        <option value="mobile_asc" <%= filters.sort === 'mobile_asc' ? 'selected' : '' %>><%= _t('Mobile number (↑)') %></option>
        <option value="mobile_desc" <%= filters.sort === 'mobile_desc' ? 'selected' : '' %>><%= _t('Mobile number (↓)') %></option>
      </select>
    </div>
    <div>
      <label><%= _t('Duplicates') %></label>
      <label class="check-pill" style="height:36px">
        <input type="checkbox" name="dups" value="1" <%= filters.dups ? 'checked' : '' %>> <%= _t('Only duplicate numbers') %> </label>
    </div>
    <div><button type="submit" class="btn btn-primary"><%- icon('search', 15) %> <%= _t('Apply') %></button></div>
    <div><a href="/reports/level" class="btn btn-outline"><%- icon('refresh', 15) %> <%= _t('Reset') %></a></div>
  </form>

  <div class="table-wrapper">
    <table>
      <thead>
        <tr>
          <th style="width:44px">#</th>
          <th><%= _t('Username') %></th>
          <th><%= _t('Mobile Number') %></th>
          <th class="right"><%= _t('Total Deposited') %></th>
          <th class="right"><%= _t('Deposits') %></th>
          <th><%= _t('Level') %></th>
          <th><%= _t('Status') %></th>
          <th><%= _t('Remark') %></th>
          <th class="right"><%= _t('Action') %></th>
        </tr>
      </thead>
      <tbody>
        <% if (!data.rows.length) { %>
          <tr><td colspan="9"><div class="empty"><span class="big">—</span><%= _t('No client found.') %></div></td></tr>
        <% } %>
        <% data.rows.forEach(function (r, i) { %>
          <tr>
            <td class="num muted"><%= (data.page - 1) * data.perPage + i + 1 %></td>
            <td class="who"><strong><%= r.username %></strong></td>
            <td class="num nowrap">
              <%= mask(r.mobile) %>
              <% if (r.dupeCount > 1) { %><span class="badge badge-warn">×<%= r.dupeCount %></span><% } %>
            </td>
            <td class="money right"><%= helpers.money(r.total_deposited) %></td>
            <td class="num right"><%= r.deposit_count %></td>
            <td><span class="badge <%= r.levelClass %>"><%= r.levelName || _t('No level') %></span></td>
            <td>
              <% if (r.active) { %>
                <span class="badge badge-success"><%= _t('Active') %></span>
              <% } else { %>
                <span class="badge badge-danger"><%= _t('Inactive') %></span>
                <span class="muted tiny" style="display:block;margin-top:3px"><%= helpers.relativeDays(r.last_deposit, helpers.today()) %></span>
              <% } %>
            </td>
            <td>
              <% if (r.followup) { %>
                <div class="note" title="<%= r.followup.response %>"><%= r.followup.response || '—' %></div>
                <span class="muted tiny" style="display:block"><%= _t(r.followup.action_type) %> · <%= r.followup.action_date %></span>
              <% } else { %><span class="muted">—</span><% } %>
            </td>
            <td class="right">
              <button type="button" class="btn btn-sm" onclick="openFollowup('<%= r.username.replace(/'/g, "\\'") %>')">
                <%- icon('phone', 13) %>
              </button>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <div class="card-footer pagination">
    <span class="page-info"><%= _t('Page {page} of {pages} · {total} rows', { page: (data.page), pages: (data.pages), total: (data.total.toLocaleString('en-IN')) }) %></span>
    <% const q = 'sort=' + filters.sort + (filters.level ? '&level=' + filters.level : '') + (filters.dups ? '&dups=1' : ''); %>
    <% if (data.page > 1) { %>
      <a class="btn btn-sm" href="/reports/level?<%= q %>&page=<%= data.page - 1 %>"><%- icon('left', 14) %> <%= _t('Prev') %></a>
    <% } %>
    <% if (data.page < data.pages) { %>
      <a class="btn btn-sm" href="/reports/level?<%= q %>&page=<%= data.page + 1 %>"><%= _t('Next') %> <%- icon('right', 14) %></a>
    <% } %>
  </div>
</div>

<%- include('partials/foot') %>


