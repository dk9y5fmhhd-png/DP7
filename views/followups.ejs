<%- include('partials/head') %>

<div class="page-head">
  <div class="titles">
    <h1><%= _t('Follow-ups') %></h1>
    <div class="sub"><%= _t('Full call log — who, when, what happened.') %></div>
  </div>
  <div class="chips">
    <button class="chip" type="button" onclick="openFollowup('')"><%- icon('plus', 13) %><%= _t('New follow-up') %></button>
  </div>
</div>

<div class="stat-grid">
  <% byType.slice(0, 5).forEach(function (t) { %>
    <div class="stat">
      <div class="label"><%= _t(t.action_type) %></div>
      <div class="value"><%= t.c.toLocaleString('en-IN') %></div>
      <div class="hint"><%= _t('total logged') %></div>
    </div>
  <% }); %>
  <% if (!byType.length) { %>
    <div class="stat"><div class="label"><%= _t('Follow-ups') %></div><div class="value">0</div><div class="hint"><%= _t('nobody yet') %></div></div>
  <% } %>
</div>

<div class="card">
  <form method="get" action="/followups" class="filter-bar">
    <div style="flex:1 1 240px">
      <label><%= _t('Search') %></label>
      <input type="search" name="q" value="<%= q %>" placeholder="<%= _t('username or notes…') %>" style="width:100%">
    </div>
    <div>
      <label><%= _t('Action') %></label>
      <select name="action" data-autosubmit>
        <option value=""><%= _t('All actions') %></option>
        <% actionTypes.forEach(function (a) { %>
          <option value="<%= a %>" <%= action === a ? 'selected' : '' %>><%= _t(a) %></option>
        <% }); %>
      </select>
    </div>
    <div><button type="submit" class="btn btn-primary"><%- icon('search', 15) %> <%= _t('Search') %></button></div>
    <div><a href="/followups" class="btn btn-outline"><%- icon('refresh', 15) %> <%= _t('Reset') %></a></div>
  </form>

  <div class="table-wrapper">
    <table>
      <thead><tr><th><%= _t('Date') %></th><th><%= _t('Username') %></th><th><%= _t('Action') %></th><th><%= _t('Response / Notes') %></th><th><%= _t('Logged by') %></th><th class="right">—</th></tr></thead>
      <tbody>
        <% if (!rows.length) { %>
          <tr><td colspan="6"><div class="empty"><span class="big">—</span><%= _t('No follow-up found.') %></div></td></tr>
        <% } %>
        <% rows.forEach(function (f) { %>
          <tr>
            <td class="nowrap"><strong><%= f.action_date %></strong></td>
            <td class="who"><strong><%= f.username %></strong></td>
            <td><span class="badge badge-accent"><%= _t(f.action_type) %></span></td>
            <td><%= f.response || '—' %></td>
            <td class="muted tiny"><%= f.by_name || '—' %></td>
            <td class="right">
              <% if (user.role === 'super_admin') { %>
                <form method="post" action="/followups/<%= f.id %>/delete" style="margin:0">
                  <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                  <button class="btn btn-danger btn-sm" data-confirm="<%= _t('Delete this follow-up?') %>" title="<%= _t('Delete') %>"><%- icon('x', 13) %></button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <div class="card-footer pagination">
    <span class="page-info"><%= _t('Page {page} of {pages} · {total} entries', { page: (page), pages: (pages), total: (total.toLocaleString('en-IN')) }) %></span>
    <% if (page > 1) { %>
      <a class="btn btn-sm" href="/followups?q=<%= encodeURIComponent(q) %>&action=<%= encodeURIComponent(action) %>&page=<%= page - 1 %>"><%- icon('left', 14) %> <%= _t('Prev') %></a>
    <% } %>
    <% if (page < pages) { %>
      <a class="btn btn-sm" href="/followups?q=<%= encodeURIComponent(q) %>&action=<%= encodeURIComponent(action) %>&page=<%= page + 1 %>"><%= _t('Next') %> <%- icon('right', 14) %></a>
    <% } %>
  </div>
</div>

<%- include('partials/foot') %>

