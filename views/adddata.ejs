<%- include('partials/head') %>

<div class="page-head">
  <div class="titles">
    <h1><%= _t('Add Data') %></h1>
    <div class="sub"><%= _t('Upload an Excel / CSV file — or paste the rows directly. One file can hold several dates.') %></div>
  </div>
  <div class="chips">
    <a class="chip" href="/add-data/template"><%- icon('download', 13) %> <%= _t('Excel template') %></a>
  </div>
</div>

<% if (result) { %>
  <div class="flash flash-<%= result.errors && result.errors.length ? 'info' : 'success' %>">
    <%- icon(result.dryRun ? 'alert' : 'check', 15) %>
    <span>
      <% if (result.empty) { %>
        <strong><%= _t('No valid row found.') %></strong>
        <% if (result.mode === 'file') { %> <%- _th('Could not read the data in this file. Download the template and use that format (columns: <code>date, username, mobile, amount</code>).') %> <% } else { %> <%- _th('Check the format: <code>username mobile amount</code>') %>
        <% } %>
      <% } else if (result.dryRun) { %>
        <%- _th('<strong>Preview</strong> — {totalRows} valid rows found{n}. Nothing has been saved yet. Review the list below and press <strong>Save</strong> to save.', { totalRows: (result.totalRows), n: (result.dates && result.dates.length > 1 ? _t(', across {n} different dates', { n: result.dates.length }) : '') }) %><% } else { %>
        <%- _th('<strong>{inserted}</strong> rows saved {playDate}{n}.', { inserted: (result.inserted), playDate: (result.dates && result.dates.length > 1 ? _t('({n} dates)', { n: result.dates.length }) : '— ' + result.playDate), n: (result.skipped ? _t(', {n} skipped (already existed)', { n: result.skipped }) : '') }) %> <% } %>
      <% if (result.errors && result.errors.length) { %> <%- _th('· <strong>{n}</strong> lines skipped.', { n: (result.errors.length) }) %><% } %>
    </span>
  </div>

  <div class="card">
    <div class="card-header">
      <h3><%- icon('file', 15) %><%= _t('File read') %></h3>
      <span class="muted tiny" style="margin-left:auto">
        <% if (result.fileName) { %><%= result.fileName %><% } %>
        <% if (result.sheet) { %> <%= _t('· sheet "{sheet}"', { sheet: (result.sheet) }) %><% } %>
      </span>
    </div>
    <div class="card-body">
      <dl class="kv">
        <dt><%= _t('Valid rows') %></dt><dd><%= result.totalRows || 0 %></dd>
        <dt><%= _t('Date') %></dt>
        <dd>
          <% if (result.usedDateColumn) { %><%= _t('From the file\'s date column ({n} different days)', { n: ((result.dates || []).length) }) %><% } else { %><%= _t('The form date —{playDate}', { playDate: (result.playDate) }) %>
          <% } %>
        </dd>
        <% if (result.headerMap) { %>
          <dt><%= _t('Columns') %></dt>
          <dd>
            <% const names = { date: _t('Date'), username: _t('Username'), mobile: _t('Mobile'), amount: _t('Amount') };
               Object.keys(result.headerMap).forEach(function (k, i) { %>
              <span class="badge badge-neutral"><%= _t('{k} → column {n}', { k: (names[k] || k), n: (result.headerMap[k] + 1) }) %></span>
            <% }); %>
          </dd>
        <% } else if (result.mode === 'file') { %>
          <dt><%= _t('Columns') %></dt><dd class="muted"><%= _t('No header found — first column is treated as username, second as mobile, third as amount.') %></dd>
        <% } %>
        <% if (result.perDate && result.perDate.length) { %>
          <dt><%= _t('Saved') %></dt>
          <dd>
            <% result.perDate.forEach(function (p) { %>
              <span class="badge badge-success"><%= p.date %> · <%= p.inserted %><%= p.skipped ? ' (+' + p.skipped + ' skip)' : '' %></span>
            <% }); %>
          </dd>
        <% } %>
      </dl>
    </div>
  </div>

  <% if (result.errors && result.errors.length) { %>
    <div class="card">
      <div class="card-header"><h3><%- icon('alert', 15) %> <%= _t('Skipped lines') %></h3></div>
      <div class="table-wrapper">
        <table>
          <thead><tr><th style="width:70px"><%= _t('Line') %></th><th><%= _t('Content') %></th><th><%= _t('Reason') %></th></tr></thead>
          <tbody>
            <% result.errors.slice(0, 50).forEach(function (e) { %>
              <tr><td class="num"><%= e.line %></td><td><code><%= e.text %></code></td><td><span class="badge badge-danger"><%= _t(e.reason) %></span></td></tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% if (result.errors.length > 50) { %>
        <div class="card-footer muted tiny"><%= _t('Showing only the first 50 errors.') %></div>
      <% } %>
    </div>
  <% } %>

  <% if (result.parsed && result.parsed.length) { %>
    <div class="card">
      <div class="card-header">
        <h3><%- icon('list', 15) %> <%= _t('Parsed preview') %></h3>
        <span class="muted tiny" style="margin-left:auto"><%= _t('{n} of {totalRows} rows', { n: (result.parsed.length), totalRows: (result.totalRows) }) %></span>
      </div>
      <div class="table-wrapper">
        <table>
          <thead><tr><th style="width:70px"><%= _t('Line') %></th><th><%= _t('Date') %></th><th><%= _t('Username') %></th><th><%= _t('Mobile') %></th><th class="right"><%= _t('Amount') %></th></tr></thead>
          <tbody>
            <% result.parsed.forEach(function (r) { %>
              <tr>
                <td class="num muted"><%= r.line %></td>
                <td class="nowrap muted"><%= r.date %></td>
                <td><strong><%= r.username %></strong></td>
                <td class="num"><%= mask(r.mobile) %></td>
                <td class="money right"><%= helpers.moneyExact(r.amount) %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>
<% } %>

<div class="grid-2" style="grid-template-columns: 1.2fr 1fr">
  <div class="card">
    <div class="card-header">
      <h3><%- icon('download', 15) %> <%= _t('Excel / CSV upload') %></h3>
      <span class="muted tiny" style="margin-left:auto"><%= _t('.xlsx · .csv') %></span>
    </div>
    <form method="post" action="/add-data" enctype="multipart/form-data" id="uploadForm">
      <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
      <div class="card-body">
        <label class="dropzone" id="dropzone">
          <input type="file" name="file" accept=".xlsx,.xlsm,.csv,.txt" id="fileInput" required>
          <span class="dz-icon"><%- icon('file', 26) %></span>
          <span class="dz-title" id="dzTitle"><%= _t('Drop the Excel file here') %></span>
          <span class="dz-sub"><%= _t('or click to choose · .xlsx or .csv · max 20 MB') %></span>
        </label>

        <div class="filter-bar" style="padding:16px 0 0;border:0;background:none">
          <div>
            <label><%= _t('Play date') %> <span class="muted tiny"><%= _t('(only used when the file has no date column)') %></span></label>
            <input type="date" name="play_date" value="<%= today %>" max="<%= helpers.today() %>">
          </div>
        </div>

        <p class="muted tiny" style="margin:12px 0 0"><%- _th('The easiest column names are <code>date</code>, <code>username</code>, <code>mobile</code>, <code>amount</code>. Column order can change — the header is read automatically. Need a template? Use the <strong>Excel template</strong> link above.') %></p>
      </div>
      <div class="card-footer" style="display:flex;gap:9px;justify-content:flex-end">
        <button type="submit" name="dry" value="1" class="btn"><%- icon('search', 15) %> <%= _t('Preview only') %></button>
        <button type="submit" name="dry" value="0" class="btn btn-primary"><%- icon('check', 15) %> <%- _th('Upload &amp; save') %></button>
      </div>
    </form>
  </div>

  <div class="card">
    <div class="card-header">
      <h3><%- icon('clock', 15) %> <%= _t('Recent days') %></h3>
    </div>
    <div class="table-wrapper">
      <table>
        <thead><tr><th><%= _t('Date') %></th><th class="right"><%= _t('Rows') %></th><th class="right"><%= _t('Clients') %></th><th class="right"><%= _t('Amount') %></th></tr></thead>
        <tbody>
          <% days.forEach(function (d) { %>
            <tr>
              <td class="nowrap"><strong><%= helpers.prettyDate(d.d) %></strong></td>
              <td class="num right"><%= d.entries %></td>
              <td class="num right"><%= d.clients %></td>
              <td class="money right"><%= helpers.money(d.amount) %></td>
            </tr>
          <% }); %>
          <% if (!days.length) { %>
            <tr><td colspan="4"><div class="empty"><%= _t('No data yet.') %></div></td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<details class="card" style="padding:0">
  <summary class="card-header" style="cursor:pointer;list-style:none">
    <h3 style="display:inline-flex"><%- icon('plus', 15) %><%= _t('Or paste directly') %></h3>
    <span class="muted tiny" style="margin-left:auto"><%= _t('for a short list') %></span>
  </summary>
  <form method="post" action="/add-data" enctype="multipart/form-data">
    <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
    <div class="card-body">
      <div class="filter-bar" style="padding:0 0 14px;border:0;background:none">
        <div>
          <label><%= _t('Play date') %></label>
          <input type="date" name="play_date" value="<%= today %>" max="<%= helpers.today() %>" required>
        </div>
      </div>
      <div class="form-group">
        <label><%= _t('Rows') %></label>
        <textarea name="rows" placeholder="<%- _th('username mobile amount&#10;rahul123 9876543210 500&#10;priya_s 9123456780 1200') %>"><%= draft %></textarea>
        <span class="muted tiny"> <%- _th('Format: <code>username mobile amount</code>— separated by comma, tab or space. Amount is optional (blank = 0).') %></span>
      </div>
    </div>
    <div class="card-footer" style="display:flex;gap:9px;justify-content:flex-end">
      <button type="submit" name="dry" value="1" class="btn"><%- icon('search', 15) %> <%= _t('Preview only') %></button>
      <button type="submit" name="dry" value="0" class="btn btn-primary"><%- icon('check', 15) %> <%= _t('Save entries') %></button>
    </div>
  </form>
</details>

<div class="card">
  <div class="card-header">
    <h3><%- icon('alert', 15) %> <%= _t('Danger zone — delete one day\'s data') %></h3>
  </div>
  <form method="post" action="/add-data/delete-day">
    <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
    <div class="card-body">
      <div class="form-row" style="align-items:flex-end">
        <div class="form-group" style="margin:0">
          <label><%= _t('Date') %></label>
          <input type="date" name="play_date" required>
        </div>
        <div class="form-group" style="margin:0">
          <label><%= _t('T-PIN') %></label>
          <input type="password" name="pin" placeholder="••••••" required autocomplete="off">
        </div>
        <div class="form-group" style="margin:0">
          <button type="submit" class="btn btn-danger" data-confirm="<%= _t('All data for this day will be deleted. Confirm?') %>">
            <%- icon('x', 15) %> <%= _t('Delete day') %> </button>
        </div>
      </div>
      <p class="muted tiny" style="margin:12px 0 0"><%= _t('This action is permanent. Export a CSV from Backup first.') %></p>
    </div>
  </form>
</div>

<%- include('partials/foot') %>



